---
 usr/share/gamescope-session-plus/gamescope-session-plus | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/usr/share/gamescope-session-plus/gamescope-session-plus b/usr/share/gamescope-session-plus/gamescope-session-plus
index 73564da..c5d96fe 100755
--- a/usr/share/gamescope-session-plus/gamescope-session-plus
+++ b/usr/share/gamescope-session-plus/gamescope-session-plus
@@ -117,6 +117,11 @@ if [ -f /usr/share/gamescope-session-plus/device-quirks ]; then
 	. /usr/share/gamescope-session-plus/device-quirks
 fi
 
+# Source Armada device quirks if exists
+if [ -f /usr/libexec/armada/device-env ]; then
+        eval "$(/usr/libexec/armada/device-env)"
+fi
+
 # Source client app specific configuration files
 set -a
 for i in ${CLIENT_CONFIG_DIR_USR}/${CLIENT} ${CLIENT_CONFIG_DIR_ETC}/${CLIENT} ${CLIENT_CONFIG_DIR_LOCAL}/${CLIENT}; do
