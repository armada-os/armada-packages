From: Radical <radical@radical.fun>
Date: Wed, 5 Aug 2026 05:29:45 +0200
Subject: [PATCH 3/4] add KONKR Pocket FIT Elite

---
 usr/share/gamescope-session-plus/device-quirks | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/usr/share/gamescope-session-plus/device-quirks b/usr/share/gamescope-session-plus/device-quirks
index 182afec..d5e6eb0 100644
--- a/usr/share/gamescope-session-plus/device-quirks
+++ b/usr/share/gamescope-session-plus/device-quirks
@@ -317,6 +317,15 @@ if [[ ":AYN Thor:" =~ ":$SYS_ID:" ]]; then
   export STEAM_DISPLAY_REFRESH_LIMITS=60,120
 fi
 
+if [[ ":KONKR Pocket FIT Elite:" =~ ":$SYS_ID:" ]]; then
+  ORIENTATION=right
+  OUTPUT_CONNECTOR='*,DSI-1'
+  CUSTOM_REFRESH_RATES=60,90,120,144
+  OUTPUT_MM=177x100
+
+  export STEAM_DISPLAY_REFRESH_LIMITS=60,90,120,144
+fi
+
 if [[ ":KONKR Pocket FIT:" =~ ":$SYS_ID:" ]]; then
   ORIENTATION=right
   CUSTOM_REFRESH_RATES=144
