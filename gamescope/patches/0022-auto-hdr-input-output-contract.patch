diff --git a/tests/test_auto_hdr_input_contract.cpp b/tests/test_auto_hdr_input_contract.cpp
new file mode 100644
index 00000000..7ccdd39a
--- /dev/null
+++ b/tests/test_auto_hdr_input_contract.cpp
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#include "AutoHDRInputContract.h"
+#include "DRMFormatInfo.h"
+
+#include <catch2/catch_test_macros.hpp>
+#include <drm_fourcc.h>
+
+using namespace gamescope::autohdr;
+
+TEST_CASE("Auto HDR accepts only explicitly represented full-range sRGB RGB input")
+{
+	const InputContract hardware = classifyInput(
+		true,
+		VK_FORMAT_B8G8R8A8_UNORM,
+		VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+		false );
+	CHECK( hardware.transfer == InputTransfer::SRGB );
+	CHECK( hardware.range == InputRange::Full );
+	CHECK( hardware.decode == InputDecode::HardwareSRGBView );
+	CHECK( hardware.autoHDREligible() );
+
+	const InputContract explicitDecode = classifyInput(
+		true,
+		VK_FORMAT_A2B10G10R10_UNORM_PACK32,
+		VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+		false );
+	CHECK( explicitDecode.transfer == InputTransfer::SRGB );
+	CHECK( explicitDecode.range == InputRange::Full );
+	CHECK( explicitDecode.decode == InputDecode::ExplicitSRGB );
+	CHECK( explicitDecode.autoHDREligible() );
+}
+
+TEST_CASE("Auto HDR fails closed when client metadata cannot distinguish the input contract")
+{
+	const InputContract implicit = classifyInput(
+		false,
+		VK_FORMAT_B8G8R8A8_UNORM,
+		VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+		false );
+	CHECK( implicit.transfer == InputTransfer::SRGB );
+	CHECK( implicit.range == InputRange::Full );
+	CHECK( implicit.decode == InputDecode::HardwareSRGBView );
+	CHECK( implicit.reason == InputContractReason::ImplicitSRGBDefault );
+	CHECK( implicit.autoHDREligible() );
+
+	const InputContract missing = classifyInput(
+		false,
+		VK_FORMAT_UNDEFINED,
+		VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+		false );
+	CHECK( missing.transfer == InputTransfer::Unknown );
+	CHECK( missing.range == InputRange::Unknown );
+	CHECK( missing.reason == InputContractReason::MissingMetadata );
+	CHECK_FALSE( missing.autoHDREligible() );
+
+	const InputContract ycbcr = classifyInput(
+		true,
+		VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+		VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+		true );
+	CHECK( ycbcr.reason == InputContractReason::YCbCrRangeUnspecified );
+	CHECK( ycbcr.range == InputRange::Unknown );
+	CHECK_FALSE( ycbcr.autoHDREligible() );
+
+	const InputContract unknown = classifyInput(
+		true,
+		VK_FORMAT_B8G8R8A8_UNORM,
+		static_cast<VkColorSpaceKHR>( 0x7fffffff ),
+		false );
+	CHECK( unknown.reason == InputContractReason::UnsupportedColorspace );
+	CHECK_FALSE( unknown.autoHDREligible() );
+}
+
+TEST_CASE("Native scRGB and PQ remain bypass states")
+{
+	const InputContract scrgb = classifyInput(
+		true,
+		VK_FORMAT_R16G16B16A16_SFLOAT,
+		VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT,
+		false );
+	CHECK( scrgb.transfer == InputTransfer::ScRGBLinear );
+	CHECK( scrgb.decode == InputDecode::None );
+	CHECK( scrgb.reason == InputContractReason::NativeScRGB );
+	CHECK_FALSE( scrgb.autoHDREligible() );
+
+	const InputContract pq = classifyInput(
+		true,
+		VK_FORMAT_A2B10G10R10_UNORM_PACK32,
+		VK_COLOR_SPACE_HDR10_ST2084_EXT,
+		false );
+	CHECK( pq.transfer == InputTransfer::PQ );
+	CHECK( pq.decode == InputDecode::None );
+	CHECK( pq.reason == InputContractReason::NativePQ );
+	CHECK_FALSE( pq.autoHDREligible() );
+}
+
+TEST_CASE("KMS compositing format diagnostics report component depth")
+{
+	CHECK( gamescope::drmFormatName( DRM_FORMAT_XRGB2101010 ) == "XRGB2101010" );
+	CHECK( gamescope::drmFormatBitDepth( DRM_FORMAT_XRGB2101010 ) == 10 );
+	CHECK( gamescope::drmFormatName( DRM_FORMAT_ARGB8888 ) == "ARGB8888" );
+	CHECK( gamescope::drmFormatBitDepth( DRM_FORMAT_ARGB8888 ) == 8 );
+	CHECK( gamescope::drmFormatName( DRM_FORMAT_NV12 ) == "unknown" );
+	CHECK( gamescope::drmFormatBitDepth( DRM_FORMAT_NV12 ) == 0 );
+}
