-	layer->autoHDRCandidate =
+	const bool sceneCandidate =
 		( flags & PaintWindowFlag::BasePlane ) &&
 		w->appID != 0 &&
 		!lastCommit->is_steam &&
@@ -2306,6 +2307,30 @@ paint_window_commit( const gamescope::Rc<commit_t> &lastCommit, steamcompmgr_win
 		!w->isOverlay &&
 		!w->isExternalOverlay &&
 		!( flags & PaintWindowFlag::NotificationMode );
+	const gamescope::autohdr::InputContract inputContract =
+		gamescope::autohdr::classifyInput(
+			lastCommit->feedback.has_value(),
+			layer->tex ? layer->tex->format() : VK_FORMAT_UNDEFINED,
+			lastCommit->feedback ? lastCommit->feedback->vk_colorspace : VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+			layer->isYcbcr() );
+	layer->autoHDRCandidate = sceneCandidate && inputContract.autoHDREligible();
+
+	const bool unrepresentableInput =
+		inputContract.reason == gamescope::autohdr::InputContractReason::MissingMetadata ||
+		inputContract.reason == gamescope::autohdr::InputContractReason::YCbCrRangeUnspecified ||
+		inputContract.reason == gamescope::autohdr::InputContractReason::UnsupportedColorspace;
+	if ( sceneCandidate && unrepresentableInput )
+	{
+		static bool s_loggedUnrepresentableInputContract = false;
+		if ( !s_loggedUnrepresentableInputContract )
+		{
+			auto_hdr_log.warnf(
+				"Auto HDR input bypassed (%.*s): swapchain feedback exposes only VkFormat and VkColorSpaceKHR; gamma 2.2, gamma 2.4, BT.1886, linear SDR, and limited-range SDR cannot be distinguished and are not guessed",
+				int( gamescope::autohdr::inputContractReasonName( inputContract.reason ).size() ),
+				gamescope::autohdr::inputContractReasonName( inputContract.reason ).data() );
+			s_loggedUnrepresentableInputContract = true;
+		}
+	}
 
 	return layer;
 }
