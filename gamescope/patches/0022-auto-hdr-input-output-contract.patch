diff --git a/src/AutoHDRInputContract.cpp b/src/AutoHDRInputContract.cpp
new file mode 100644
index 00000000..db4e8385
--- /dev/null
+++ b/src/AutoHDRInputContract.cpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#include "AutoHDRInputContract.h"
+
+namespace gamescope::autohdr
+{
+	namespace
+	{
+		bool supportsHardwareSRGBDecode( VkFormat format )
+		{
+			switch ( format )
+			{
+				case VK_FORMAT_B8G8R8A8_UNORM:
+				case VK_FORMAT_B8G8R8A8_SRGB:
+				case VK_FORMAT_R8G8B8A8_UNORM:
+				case VK_FORMAT_R8G8B8A8_SRGB:
+					return true;
+				default:
+					return false;
+			}
+		}
+	}
+
+	InputContract classifyInput(
+		bool metadataPresent,
+		VkFormat format,
+		VkColorSpaceKHR colorspace,
+		bool ycbcr ) noexcept
+	{
+		if ( ycbcr )
+		{
+			return {
+				.transfer = InputTransfer::Unknown,
+				.range = InputRange::Unknown,
+				.decode = InputDecode::None,
+				.reason = InputContractReason::YCbCrRangeUnspecified,
+			};
+		}
+
+		if ( !metadataPresent )
+		{
+			if ( format == VK_FORMAT_UNDEFINED )
+				return {};
+
+			// commit_t::colorspace() deliberately defines feedback-free RGB
+			// surfaces as nonlinear sRGB. Preserve that compositor contract so
+			// native OpenGL, EGL, software rendering, and other non-WSI clients
+			// do not lose Auto HDR coverage.
+			return {
+				.transfer = InputTransfer::SRGB,
+				.range = InputRange::Full,
+				.decode = supportsHardwareSRGBDecode( format )
+					? InputDecode::HardwareSRGBView
+					: InputDecode::ExplicitSRGB,
+				.reason = InputContractReason::ImplicitSRGBDefault,
+			};
+		}
+
+		switch ( colorspace )
+		{
+			case VK_COLOR_SPACE_SRGB_NONLINEAR_KHR:
+				return {
+					.transfer = InputTransfer::SRGB,
+					.range = InputRange::Full,
+					.decode = supportsHardwareSRGBDecode( format )
+						? InputDecode::HardwareSRGBView
+						: InputDecode::ExplicitSRGB,
+					.reason = InputContractReason::Eligible,
+				};
+
+			case VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT:
+				return {
+					.transfer = InputTransfer::ScRGBLinear,
+					.range = InputRange::Full,
+					.decode = InputDecode::None,
+					.reason = InputContractReason::NativeScRGB,
+				};
+
+			case VK_COLOR_SPACE_HDR10_ST2084_EXT:
+				return {
+					.transfer = InputTransfer::PQ,
+					.range = InputRange::Full,
+					.decode = InputDecode::None,
+					.reason = InputContractReason::NativePQ,
+				};
+
+			default:
+				return {
+					.transfer = InputTransfer::Unknown,
+					.range = InputRange::Unknown,
+					.decode = InputDecode::None,
+					.reason = InputContractReason::UnsupportedColorspace,
+				};
+		}
+	}
+
+	std::string_view inputContractReasonName( InputContractReason reason ) noexcept
+	{
+		switch ( reason )
+		{
+			case InputContractReason::Eligible: return "eligible-srgb-full-range";
+			case InputContractReason::ImplicitSRGBDefault:
+				return "eligible-implicit-srgb-default";
+			case InputContractReason::MissingMetadata: return "missing-client-color-metadata";
+			case InputContractReason::YCbCrRangeUnspecified: return "ycbcr-range-unspecified";
+			case InputContractReason::NativeScRGB: return "native-scrgb-bypass";
+			case InputContractReason::NativePQ: return "native-pq-bypass";
+			case InputContractReason::UnsupportedColorspace: return "unsupported-client-colorspace";
+		}
+		return "unknown";
+	}
+}
diff --git a/src/AutoHDRInputContract.h b/src/AutoHDRInputContract.h
new file mode 100644
index 00000000..aefd56a3
--- /dev/null
+++ b/src/AutoHDRInputContract.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#pragma once
+
+#include "vulkan_include.h"
+
+#include <cstdint>
+#include <string_view>
+
+namespace gamescope::autohdr
+{
+	enum class InputTransfer : uint8_t
+	{
+		Unknown = 0,
+		SRGB,
+		ScRGBLinear,
+		PQ,
+	};
+
+	enum class InputRange : uint8_t
+	{
+		Unknown = 0,
+		Full,
+	};
+
+	enum class InputDecode : uint8_t
+	{
+		None = 0,
+		HardwareSRGBView,
+		ExplicitSRGB,
+	};
+
+	enum class InputContractReason : uint8_t
+	{
+		Eligible = 0,
+		ImplicitSRGBDefault,
+		MissingMetadata,
+		YCbCrRangeUnspecified,
+		NativeScRGB,
+		NativePQ,
+		UnsupportedColorspace,
+	};
+
+	struct InputContract
+	{
+		InputTransfer transfer = InputTransfer::Unknown;
+		InputRange range = InputRange::Unknown;
+		InputDecode decode = InputDecode::None;
+		InputContractReason reason = InputContractReason::MissingMetadata;
+
+		constexpr bool autoHDREligible() const
+		{
+			return reason == InputContractReason::Eligible ||
+				reason == InputContractReason::ImplicitSRGBDefault;
+		}
+	};
+
+	// The swapchain feedback protocol exposes VkFormat and VkColorSpaceKHR, but
+	// no distinct gamma 2.2, gamma 2.4, BT.1886, linear-SDR, or quantization
+	// range fields. Feedback-free RGB surfaces retain Gamescope's established
+	// implicit sRGB default. Only classify states the compositor can represent.
+	InputContract classifyInput(
+		bool metadataPresent,
+		VkFormat format,
+		VkColorSpaceKHR colorspace,
+		bool ycbcr ) noexcept;
+
+	std::string_view inputContractReasonName( InputContractReason reason ) noexcept;
+}
