index 00000000..b2f86e03
--- /dev/null
+++ b/src/AutoHDRAdaptive.h
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "shaders/auto_hdr_adaptive_constants.h"
+
+namespace gamescope::autohdr
+{
+	struct AnalysisGrid
+	{
+		uint32_t width = 0;
+		uint32_t height = 0;
+	};
+
+	struct SceneSample
+	{
+		// Luminance is normalized to the declared SDR input range. Coverage is
+		// the visible base-layer contribution after bounds and alpha handling.
+		double luminance = 0.0;
+		double coverage = 0.0;
+	};
+
+	struct SceneStats
+	{
+		// All scene values are normalized to the SDR input range [0, 1].
+		double mean = 0.0;
+		double upperOccupancy = 0.0;
+		double approximatePeak = 0.0;
+		double broadFieldLoad = 0.0;
+		double validCoverage = 0.0;
+	};
+
+	struct AdaptiveConfig
+	{
+		bool enabled = false;
+		double efficientCeilingNits = GAMESCOPE_AUTO_HDR_DEFAULT_EFFICIENT_NITS;
+		double outputPeakNits = GAMESCOPE_AUTO_HDR_DEFAULT_EFFICIENT_NITS;
+
+		// Development constants are deliberately explicit so device testing can
+		// tune policy without changing the controller structure. They were
+		// independently selected from normalized scene quantities.
+		double minimumValidCoverage = GAMESCOPE_AUTO_HDR_MINIMUM_VALID_COVERAGE;
+		double peakStart = GAMESCOPE_AUTO_HDR_PEAK_START;
+		double peakFull = GAMESCOPE_AUTO_HDR_PEAK_FULL;
+		double occupancyStart = GAMESCOPE_AUTO_HDR_OCCUPANCY_START;
+		double occupancyFull = GAMESCOPE_AUTO_HDR_OCCUPANCY_FULL;
+		double broadFieldStart = GAMESCOPE_AUTO_HDR_BROAD_FIELD_START;
+		double broadFieldFull = GAMESCOPE_AUTO_HDR_BROAD_FIELD_FULL;
+		double meanProtectionStart = GAMESCOPE_AUTO_HDR_MEAN_PROTECTION_START;
+		double meanProtectionFull = GAMESCOPE_AUTO_HDR_MEAN_PROTECTION_FULL;
+		double maximumBroadFieldProtection =
