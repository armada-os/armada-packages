@@ -0,0 +1,507 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#include "AutoHDRAdaptive.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace gamescope::autohdr
+{
+	namespace
+	{
+		double finiteClamped( double value, double lower, double upper )
+		{
+			return std::isfinite( value ) ? std::clamp( value, lower, upper ) : lower;
+		}
+
+		double smoothstep( double lower, double upper, double value )
+		{
+			if ( !std::isfinite( value ) || !( upper > lower ) )
+				return 0.0;
+
+			const double t = std::clamp( ( value - lower ) / ( upper - lower ), 0.0, 1.0 );
+			return t * t * ( 3.0 - 2.0 * t );
+		}
+
+		double safeEfficientCeiling( const AdaptiveConfig &config )
+		{
+			if ( std::isfinite( config.efficientCeilingNits ) &&
+				config.efficientCeilingNits > 0.0 &&
+				config.efficientCeilingNits <= GAMESCOPE_AUTO_HDR_MAXIMUM_OUTPUT_NITS )
+				return config.efficientCeilingNits;
+			return GAMESCOPE_AUTO_HDR_DEFAULT_EFFICIENT_NITS;
+		}
+
+		bool finitePositive( double value )
+		{
+			return std::isfinite( value ) && value > 0.0;
+		}
+	}
+
+	AnalysisGrid sceneAnalysisGrid( uint32_t outputWidth, uint32_t outputHeight )
+	{
+		if ( outputWidth == 0 || outputHeight == 0 )
+			return {};
+
+		const bool landscape = outputWidth >= outputHeight;
+		const uint32_t longOutput = landscape ? outputWidth : outputHeight;
+		const uint32_t shortOutput = landscape ? outputHeight : outputWidth;
+		const uint64_t scaled =
+			uint64_t( GAMESCOPE_AUTO_HDR_ANALYSIS_LONG_AXIS ) * shortOutput +
+			longOutput / 2u;
+		const uint32_t shortAxis = std::clamp(
+			uint32_t( scaled / longOutput ),
+			uint32_t( GAMESCOPE_AUTO_HDR_ANALYSIS_MINIMUM_SHORT_AXIS ),
+			uint32_t( GAMESCOPE_AUTO_HDR_ANALYSIS_LONG_AXIS ) );
+
+		return landscape
+			? AnalysisGrid{ GAMESCOPE_AUTO_HDR_ANALYSIS_LONG_AXIS, shortAxis }
+			: AnalysisGrid{ shortAxis, GAMESCOPE_AUTO_HDR_ANALYSIS_LONG_AXIS };
+	}
+
+	SceneSample sanitizeSceneSample( const SceneSample &sample )
+	{
+		return {
+			finiteClamped( sample.luminance, 0.0, 1.0 ),
+			finiteClamped( sample.coverage, 0.0, 1.0 ),
+		};
+	}
+
+	SceneStats analyzeSceneSamples( const SceneSample *samples, std::size_t sampleCount )
+	{
+		if ( samples == nullptr || sampleCount == 0 )
+			return {};
+
+		double validWeight = 0.0;
+		double luminanceSum = 0.0;
+		double upperWeightSum = 0.0;
+		double broadWeightSum = 0.0;
+		double eighthMomentSum = 0.0;
+		double maximumLuminance = 0.0;
+
+		for ( std::size_t i = 0; i < sampleCount; i++ )
+		{
+			const SceneSample sample = sanitizeSceneSample( samples[i] );
+			if ( sample.coverage <= 0.0 )
+				continue;
+
+			const double luminance2 = sample.luminance * sample.luminance;
+			const double luminance4 = luminance2 * luminance2;
+			const double luminance8 = luminance4 * luminance4;
+			validWeight += sample.coverage;
+			luminanceSum += sample.coverage * sample.luminance;
+			upperWeightSum += sample.coverage *
+				smoothstep( GAMESCOPE_AUTO_HDR_UPPER_BAND_START,
+					GAMESCOPE_AUTO_HDR_UPPER_BAND_FULL, sample.luminance );
+			broadWeightSum += sample.coverage *
+				smoothstep( GAMESCOPE_AUTO_HDR_BROAD_SAMPLE_START,
+					GAMESCOPE_AUTO_HDR_BROAD_SAMPLE_FULL, sample.luminance );
+			eighthMomentSum += sample.coverage * luminance8;
+			maximumLuminance = std::max( maximumLuminance, sample.luminance );
+		}
+
+		const double validCoverage = std::clamp(
+			validWeight / double( sampleCount ), 0.0, 1.0 );
+		if ( validWeight <= 0.0 || !std::isfinite( validWeight ) )
+			return { 0.0, 0.0, 0.0, 0.0, validCoverage };
+
+		const double inverseWeight = 1.0 / validWeight;
+		const double mean = finiteClamped(
+			luminanceSum * inverseWeight, 0.0, 1.0 );
+		const double upperOccupancy = finiteClamped(
+			upperWeightSum * inverseWeight, 0.0, 1.0 );
+		const double broadFieldLoad = finiteClamped(
+			broadWeightSum * inverseWeight, 0.0, 1.0 );
+
+		// The eighth-power mean is insensitive to one unstable maximum but
+		// remains responsive to a compact highlight cluster. As soft upper-band
+		// occupancy becomes credible, blend toward the actual reduced maximum.
+		// Every term is a sum, maximum, or scalar operation suitable for a
+		// single-workgroup GPU reduction.
+		const double powerMean = std::pow(
+			std::max( eighthMomentSum * inverseWeight, 0.0 ),
+			GAMESCOPE_AUTO_HDR_POWER_MEAN_EXPONENT );
+		const double peakConfidence = smoothstep(
+			GAMESCOPE_AUTO_HDR_PEAK_CONFIDENCE_START,
+			GAMESCOPE_AUTO_HDR_PEAK_CONFIDENCE_FULL, upperOccupancy );
+		const double approximatePeak = finiteClamped(
+			powerMean + peakConfidence * ( maximumLuminance - powerMean ),
+			0.0,
+			1.0 );
+
+		return {
+			mean,
+			upperOccupancy,
+			approximatePeak,
+			broadFieldLoad,
+			validCoverage,
+		};
+	}
+
+	bool validAdaptiveConfig( const AdaptiveConfig &config )
+	{
+		return finitePositive( config.efficientCeilingNits ) &&
+			std::isfinite( config.outputPeakNits ) &&
+			config.outputPeakNits >= config.efficientCeilingNits &&
+			config.outputPeakNits <= GAMESCOPE_AUTO_HDR_MAXIMUM_OUTPUT_NITS &&
+			std::isfinite( config.minimumValidCoverage ) &&
+			config.minimumValidCoverage >= 0.0 &&
+			config.minimumValidCoverage <= 1.0 &&
+			std::isfinite( config.peakStart ) &&
+			std::isfinite( config.peakFull ) &&
+			config.peakStart >= 0.0 &&
+			config.peakFull > config.peakStart &&
+			config.peakFull <= 1.0 &&
+			std::isfinite( config.occupancyStart ) &&
+			std::isfinite( config.occupancyFull ) &&
+			config.occupancyStart >= 0.0 &&
+			config.occupancyFull > config.occupancyStart &&
+			config.occupancyFull <= 1.0 &&
+			std::isfinite( config.broadFieldStart ) &&
+			std::isfinite( config.broadFieldFull ) &&
+			config.broadFieldStart >= 0.0 &&
+			config.broadFieldFull > config.broadFieldStart &&
+			config.broadFieldFull <= 1.0 &&
+			std::isfinite( config.meanProtectionStart ) &&
+			std::isfinite( config.meanProtectionFull ) &&
+			config.meanProtectionStart >= 0.0 &&
+			config.meanProtectionFull > config.meanProtectionStart &&
+			config.meanProtectionFull <= 1.0 &&
+			std::isfinite( config.maximumBroadFieldProtection ) &&
+			config.maximumBroadFieldProtection >= 0.0 &&
+			config.maximumBroadFieldProtection <= 1.0 &&
+			std::isfinite( config.deadbandNits ) &&
+			config.deadbandNits >= 0.0 &&
+			std::isfinite( config.directionHysteresisNits ) &&
+			config.directionHysteresisNits >= 0.0 &&
+			std::isfinite( config.reductionDwellSeconds ) &&
+			config.reductionDwellSeconds >= 0.0 &&
+			std::isfinite( config.restorationDwellSeconds ) &&
+			config.restorationDwellSeconds >= 0.0 &&
+			finitePositive( config.reductionTimeConstantSeconds ) &&
+			finitePositive( config.restorationTimeConstantSeconds ) &&
+			std::isfinite( config.sceneCutMeanDelta ) &&
+			config.sceneCutMeanDelta > 0.0 &&
+			config.sceneCutMeanDelta <= 1.0 &&
+			std::isfinite( config.sceneCutPeakDelta ) &&
+			config.sceneCutPeakDelta > 0.0 &&
+			config.sceneCutPeakDelta <= 1.0 &&
+			finitePositive( config.maximumElapsedSeconds );
+	}
+
+	bool validAdaptiveStateTexels(
+		const AdaptiveStateTexels &state, const AdaptiveConfig &config )
+	{
+		if ( !validAdaptiveConfig( config ) )
+			return false;
+		const auto finiteUnit = []( double value )
+		{
+			return std::isfinite( value ) && value >= 0.0 && value <= 1.0;
+		};
+		const auto finiteNits = [&]( double value )
+		{
+			return std::isfinite( value ) &&
+				value >= config.efficientCeilingNits &&
+				value <= config.outputPeakNits;
+		};
+		const bool validDirection =
+			state.pendingDirection == -1.0 ||
+			state.pendingDirection == 0.0 ||
+			state.pendingDirection == 1.0;
+		const bool validInitialized =
+			state.initialized == 0.0 || state.initialized == 1.0;
+		return finiteNits( state.contentNits ) &&
+			finiteUnit( state.previousMean ) &&
+			finiteUnit( state.previousPeak ) &&
+			std::isfinite( state.pendingSeconds ) &&
+			state.pendingSeconds >= 0.0 &&
+			validDirection &&
+			validInitialized &&
+			finiteNits( state.desiredNits ) &&
+			finiteUnit( state.validCoverage );
+	}
+
+	SceneStats sanitizeSceneStats( const SceneStats &stats )
+	{
+		return {
+			finiteClamped( stats.mean, 0.0, 1.0 ),
+			finiteClamped( stats.upperOccupancy, 0.0, 1.0 ),
+			finiteClamped( stats.approximatePeak, 0.0, 1.0 ),
+			finiteClamped( stats.broadFieldLoad, 0.0, 1.0 ),
+			finiteClamped( stats.validCoverage, 0.0, 1.0 ),
+		};
+	}
+
+	bool validSceneStats( const SceneStats &stats )
+	{
+		const auto validUnit = []( double value )
+		{
+			return std::isfinite( value ) && value >= 0.0 && value <= 1.0;
+		};
+		return validUnit( stats.mean ) &&
+			validUnit( stats.upperOccupancy ) &&
+			validUnit( stats.approximatePeak ) &&
+			validUnit( stats.broadFieldLoad ) &&
+			validUnit( stats.validCoverage );
+	}
+
+	double desiredContentCeilingNits( const SceneStats &rawStats, const AdaptiveConfig &config )
+	{
+		if ( !validAdaptiveConfig( config ) )
+			return safeEfficientCeiling( config );
+		if ( !validSceneStats( rawStats ) )
+			return config.efficientCeilingNits;
+
+		const SceneStats stats = rawStats;
+		if ( !config.enabled || stats.validCoverage < config.minimumValidCoverage )
+			return config.efficientCeilingNits;
+
+		// A high peak creates headroom demand. Sparse upper-range occupancy
+		// confirms that the peak represents more than one unstable sample.
+		const double peakSignal = smoothstep(
+			config.peakStart, config.peakFull, stats.approximatePeak );
+		const double occupancySignal = smoothstep(
+			config.occupancyStart, config.occupancyFull, stats.upperOccupancy );
+		const double highlightDemand = peakSignal *
+			( GAMESCOPE_AUTO_HDR_HIGHLIGHT_PEAK_WEIGHT +
+			  GAMESCOPE_AUTO_HDR_HIGHLIGHT_OCCUPANCY_WEIGHT * occupancySignal );
+
+		// Bright fields reduce only the extra highlight headroom. They never
+		// reduce the established efficient-mode ceiling. Using the maximum of
+		// two smooth signals avoids a hard threshold when either scene mean or
+		// analyzed bright-area load crosses a boundary.
+		const double broadFieldSignal = smoothstep(
+			config.broadFieldStart, config.broadFieldFull, stats.broadFieldLoad );
+		const double meanSignal = smoothstep(
+			config.meanProtectionStart, config.meanProtectionFull, stats.mean );
+		const double protectionSignal = std::max( broadFieldSignal, meanSignal );
+		const double protection =
+			config.maximumBroadFieldProtection * protectionSignal;
+		const double usableHeadroom = highlightDemand * ( 1.0 - protection );
+
+		return std::clamp(
+			config.efficientCeilingNits +
+				( config.outputPeakNits - config.efficientCeilingNits ) * usableHeadroom,
+			config.efficientCeilingNits,
+			config.outputPeakNits );
+	}
+
+	double sceneCutSignal( const SceneStats &current, const SceneStats &previous,
+		const AdaptiveConfig &config )
+	{
+		if ( !validAdaptiveConfig( config ) ||
+			!validSceneStats( current ) ||
+			!validSceneStats( previous ) )
+			return 0.0;
+
+		const double meanDelta = std::abs( current.mean - previous.mean );
+		const double peakDelta =
+			std::abs( current.approximatePeak - previous.approximatePeak );
+		const double meanSignal = smoothstep(
+			GAMESCOPE_AUTO_HDR_SCENE_CUT_LOWER_FRACTION *
+				config.sceneCutMeanDelta,
+			config.sceneCutMeanDelta,
+			meanDelta );
+		const double peakSignal = smoothstep(
+			GAMESCOPE_AUTO_HDR_SCENE_CUT_LOWER_FRACTION *
+				config.sceneCutPeakDelta,
+			config.sceneCutPeakDelta,
+			peakDelta );
+		return std::max( meanSignal, peakSignal );
+	}
+
+	void AdaptiveController::reset()
+	{
+		m_contentCeilingNits = 0.0;
+		m_pendingSeconds = 0.0;
+		m_previousStats = {};
+		m_pendingDirection = Direction::None;
+		m_initialized = false;
+		m_havePreviousStats = false;
+	}
+
+	void AdaptiveController::reset( double contentCeilingNits )
+	{
+		reset();
+		if ( std::isfinite( contentCeilingNits ) && contentCeilingNits > 0.0 )
+		{
+			m_contentCeilingNits = contentCeilingNits;
+			m_initialized = true;
+		}
+	}
+
+	AdaptiveResult AdaptiveController::update(
+		const FrameInput &input, const AdaptiveConfig &config )
+	{
+		const double safeCeiling = safeEfficientCeiling( config );
+		if ( !validAdaptiveConfig( config ) )
+		{
+			reset( safeCeiling );
+			return { safeCeiling, safeCeiling, false, false, FreezeReason::InvalidConfig };
+		}
+
+		if ( !config.enabled )
+		{
+			reset( config.efficientCeilingNits );
+			return {
+				config.efficientCeilingNits,
+				config.efficientCeilingNits,
+				false,
+				false,
+				FreezeReason::Disabled,
+			};
+		}
+
+		if ( !m_initialized )
+		{
+			m_contentCeilingNits = config.efficientCeilingNits;
+			m_initialized = true;
+		}
+		m_contentCeilingNits = std::clamp(
+			m_contentCeilingNits, config.efficientCeilingNits, config.outputPeakNits );
+
+		const SceneStats stats = input.stats;
+		const double desired = validSceneStats( stats )
+			? desiredContentCeilingNits( stats, config )
+			: m_contentCeilingNits;
+		auto frozen = [&]( FreezeReason reason )
+		{
+			return AdaptiveResult{
+				m_contentCeilingNits,
+				desired,
+				false,
+				false,
+				reason,
+			};
+		};
+
+		if ( std::isfinite( input.elapsedSeconds ) &&
+			input.elapsedSeconds > config.maximumElapsedSeconds )
+		{
+			// A suspend, stall, or missing presentation invalidates temporal
+			// history. Return to Efficient and require a fresh stable sequence.
+			const bool changed =
+				m_contentCeilingNits != config.efficientCeilingNits;
+			reset();
+			m_contentCeilingNits = config.efficientCeilingNits;
+			return {
+				config.efficientCeilingNits,
+				desired,
+				changed,
+				false,
+				FreezeReason::ExcessiveElapsedTime,
+			};
+		}
+		if ( !validSceneStats( stats ) )
+		{
+			m_pendingDirection = Direction::None;
+			m_pendingSeconds = 0.0;
+			return frozen( FreezeReason::InvalidSceneStats );
+		}
+		if ( input.transitional )
+		{
+			m_pendingDirection = Direction::None;
+			m_pendingSeconds = 0.0;
+			return frozen( FreezeReason::TransitionalFrame );
+		}
+		if ( stats.validCoverage < config.minimumValidCoverage )
+		{
+			m_pendingDirection = Direction::None;
+			m_pendingSeconds = 0.0;
+			return frozen( FreezeReason::InsufficientCoverage );
+		}
+		if ( !std::isfinite( input.elapsedSeconds ) || input.elapsedSeconds <= 0.0 )
+			return frozen( FreezeReason::InvalidElapsedTime );
+		if ( input.duplicated )
+			return frozen( FreezeReason::DuplicatedFrame );
+		double cutSignal = 0.0;
+		if ( m_havePreviousStats )
+			cutSignal = sceneCutSignal( stats, m_previousStats, config );
+		m_previousStats = stats;
+		m_havePreviousStats = true;
+
+		if ( cutSignal > 0.0 )
+		{
+			m_pendingDirection = Direction::None;
+			m_pendingSeconds = 0.0;
+			if ( desired < m_contentCeilingNits )
+			{
+				// Scene transitions may shed stale headroom immediately, but
+				// the smooth cut signal avoids a binary threshold. A full cut
+				// reaches the lower target; restoration never uses this path.
+				m_contentCeilingNits = std::clamp(
+					m_contentCeilingNits +
+						cutSignal * ( desired - m_contentCeilingNits ),
+					config.efficientCeilingNits,
+					config.outputPeakNits );
+				return {
+					m_contentCeilingNits,
+					desired,
+					true,
+					true,
+					FreezeReason::None,
+				};
+			}
+		}
+
+		const double difference = desired - m_contentCeilingNits;
+		if ( std::abs( difference ) <= config.deadbandNits )
+		{
+			m_pendingDirection = Direction::None;
+			m_pendingSeconds = 0.0;
+			return frozen( FreezeReason::Deadband );
+		}
+
+		const Direction direction =
+			difference < 0.0 ? Direction::Reduce : Direction::Restore;
+		if ( m_pendingDirection != Direction::None &&
+			direction != m_pendingDirection &&
+			std::abs( difference ) <=
+				config.deadbandNits + config.directionHysteresisNits )
+		{
+			return frozen( FreezeReason::Hysteresis );
+		}
+		if ( direction != m_pendingDirection )
+		{
+			m_pendingDirection = direction;
+			m_pendingSeconds = input.elapsedSeconds;
+		}
+		else
+		{
+			m_pendingSeconds += input.elapsedSeconds;
+		}
+
+		const double dwell = direction == Direction::Reduce
+			? config.reductionDwellSeconds
+			: config.restorationDwellSeconds;
+		if ( m_pendingSeconds < dwell )
+			return frozen( FreezeReason::Dwell );
+
+		const double timeConstant = direction == Direction::Reduce
+			? config.reductionTimeConstantSeconds
+			: config.restorationTimeConstantSeconds;
+		const double blend = 1.0 - std::exp( -input.elapsedSeconds / timeConstant );
+		m_contentCeilingNits = std::clamp(
+			m_contentCeilingNits + blend * difference,
+			config.efficientCeilingNits,
+			config.outputPeakNits );
+
+		return {
+			m_contentCeilingNits,
+			desired,
+			true,
+			cutSignal > 0.0,
+			FreezeReason::None,
+		};
+	}
+
+	double AdaptiveController::contentCeilingNits() const
+	{
+		return m_contentCeilingNits;
+	}
+
+	bool AdaptiveController::initialized() const
+	{
+		return m_initialized;
+	}
+}
