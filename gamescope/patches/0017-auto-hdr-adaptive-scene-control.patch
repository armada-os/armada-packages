+// SPDX-License-Identifier: BSD-2-Clause
+
+#ifndef GAMESCOPE_AUTO_HDR_ADAPTIVE_CONSTANTS_H
+#define GAMESCOPE_AUTO_HDR_ADAPTIVE_CONSTANTS_H
+
+// Clean-room Auto HDR analysis and controller policy. This header contains
+// preprocessor constants only so the CPU reference and GLSL implementation use
+// exactly the same independently selected values.
+#define GAMESCOPE_AUTO_HDR_ANALYSIS_LONG_AXIS 96
+#define GAMESCOPE_AUTO_HDR_ANALYSIS_MINIMUM_SHORT_AXIS 32
+
+#define GAMESCOPE_AUTO_HDR_DEFAULT_EFFICIENT_NITS 203.0
+#define GAMESCOPE_AUTO_HDR_MAXIMUM_OUTPUT_NITS 10000.0
+#define GAMESCOPE_AUTO_HDR_MINIMUM_VALID_COVERAGE 0.80
+
+#define GAMESCOPE_AUTO_HDR_UPPER_BAND_START 0.70
+#define GAMESCOPE_AUTO_HDR_UPPER_BAND_FULL 0.90
+#define GAMESCOPE_AUTO_HDR_BROAD_SAMPLE_START 0.55
+#define GAMESCOPE_AUTO_HDR_BROAD_SAMPLE_FULL 0.85
+#define GAMESCOPE_AUTO_HDR_PEAK_CONFIDENCE_START 0.0005
+#define GAMESCOPE_AUTO_HDR_PEAK_CONFIDENCE_FULL 0.0040
+#define GAMESCOPE_AUTO_HDR_POWER_MEAN_EXPONENT 0.125
+
+#define GAMESCOPE_AUTO_HDR_PEAK_START 0.72
+#define GAMESCOPE_AUTO_HDR_PEAK_FULL 0.98
+#define GAMESCOPE_AUTO_HDR_OCCUPANCY_START 0.002
+#define GAMESCOPE_AUTO_HDR_OCCUPANCY_FULL 0.030
+#define GAMESCOPE_AUTO_HDR_HIGHLIGHT_PEAK_WEIGHT 0.70
+#define GAMESCOPE_AUTO_HDR_HIGHLIGHT_OCCUPANCY_WEIGHT 0.30
+#define GAMESCOPE_AUTO_HDR_BROAD_FIELD_START 0.15
+#define GAMESCOPE_AUTO_HDR_BROAD_FIELD_FULL 0.65
+#define GAMESCOPE_AUTO_HDR_MEAN_PROTECTION_START 0.30
+#define GAMESCOPE_AUTO_HDR_MEAN_PROTECTION_FULL 0.72
+#define GAMESCOPE_AUTO_HDR_MAXIMUM_BROAD_FIELD_PROTECTION 0.85
+
+#define GAMESCOPE_AUTO_HDR_DEADBAND_NITS 4.0
+#define GAMESCOPE_AUTO_HDR_DIRECTION_HYSTERESIS_NITS 3.0
+#define GAMESCOPE_AUTO_HDR_REDUCTION_DWELL_SECONDS 0.08
+#define GAMESCOPE_AUTO_HDR_RESTORATION_DWELL_SECONDS 0.24
+#define GAMESCOPE_AUTO_HDR_REDUCTION_TIME_CONSTANT_SECONDS 0.10
+#define GAMESCOPE_AUTO_HDR_RESTORATION_TIME_CONSTANT_SECONDS 0.55
+#define GAMESCOPE_AUTO_HDR_SCENE_CUT_MEAN_DELTA 0.20
+#define GAMESCOPE_AUTO_HDR_SCENE_CUT_PEAK_DELTA 0.28
+#define GAMESCOPE_AUTO_HDR_SCENE_CUT_LOWER_FRACTION 0.5
+#define GAMESCOPE_AUTO_HDR_MAXIMUM_ELAPSED_SECONDS 0.25
+
+#endif
