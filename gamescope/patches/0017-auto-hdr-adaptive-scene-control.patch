new file mode 100644
index 00000000..05b91ab6
--- /dev/null
+++ b/src/shaders/cs_auto_hdr_analyze.comp
@@ -0,0 +1,366 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+
+#include "descriptor_set_constants.h"
+#include "auto_hdr_adaptive_constants.h"
+
+layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0, scalar) uniform adaptive_data_t {
+    mat3x4 u_sourceCTM;
+    mat3x4 u_sourceTo2020;
+    vec2 u_scale;
+    vec2 u_offset;
+    uvec2 u_sourceExtent;
+    uvec2 u_displayExtent;
+    uvec2 u_gridExtent;
+    uint u_sourceColorspace;
+    uint u_sourceAlphaMode;
+    uint u_reset;
+    uint u_transitional;
+    uint u_duplicated;
+    float u_opacity;
+    float u_elapsedSeconds;
+    float u_efficientCeilingNits;
+    float u_outputPeakNits;
+};
+
+layout(binding = 1, rgba32f) writeonly uniform image2D u_nextState;
+layout(binding = 3) uniform sampler2D s_samplers[VKR_SAMPLER_SLOTS];
+
+const uint colorspace_linear = 0u;
+const uint colorspace_sRGB = 1u;
+const vec3 k_bt2020 =
+    vec3(0.262698338956556, 0.678008765772817, 0.0592928952706273);
+
+shared vec4 s_accum[128];
+shared vec4 s_extra[128];
+
+vec3 finite_nonnegative(vec3 color)
+{
+    return vec3(
+        isnan(color.r) || isinf(color.r) ? 0.0f : max(color.r, 0.0f),
+        isnan(color.g) || isinf(color.g) ? 0.0f : max(color.g, 0.0f),
+        isnan(color.b) || isinf(color.b) ? 0.0f : max(color.b, 0.0f));
+}
+
+vec3 decode_source(vec3 color)
+{
+    if (u_sourceColorspace == colorspace_sRGB)
+    {
+        bvec3 low = lessThanEqual(color, vec3(0.04045f));
+        color = mix(
+            pow((color + 0.055f) / 1.055f, vec3(2.4f)),
+            color / 12.92f,
+            low);
+    }
+    return color;
+}
+
+float smooth_unit(float lower, float upper, float value)
+{
+    float t = clamp((value - lower) / (upper - lower), 0.0f, 1.0f);
+    return t * t * (3.0f - 2.0f * t);
+}
+
+float desired_ceiling(
+    float mean, float upper_occupancy, float approximate_peak, float broad_load)
+{
+    float peak_signal = smooth_unit(
+        GAMESCOPE_AUTO_HDR_PEAK_START,
+        GAMESCOPE_AUTO_HDR_PEAK_FULL,
+        approximate_peak);
+    float occupancy_signal = smooth_unit(
+        GAMESCOPE_AUTO_HDR_OCCUPANCY_START,
+        GAMESCOPE_AUTO_HDR_OCCUPANCY_FULL,
+        upper_occupancy);
+    float highlight_demand = peak_signal *
+        (GAMESCOPE_AUTO_HDR_HIGHLIGHT_PEAK_WEIGHT +
+         GAMESCOPE_AUTO_HDR_HIGHLIGHT_OCCUPANCY_WEIGHT * occupancy_signal);
+    float broad_signal = smooth_unit(
+        GAMESCOPE_AUTO_HDR_BROAD_FIELD_START,
+        GAMESCOPE_AUTO_HDR_BROAD_FIELD_FULL,
+        broad_load);
+    float mean_signal = smooth_unit(
+        GAMESCOPE_AUTO_HDR_MEAN_PROTECTION_START,
+        GAMESCOPE_AUTO_HDR_MEAN_PROTECTION_FULL,
+        mean);
+    float protection = GAMESCOPE_AUTO_HDR_MAXIMUM_BROAD_FIELD_PROTECTION *
+        max(broad_signal, mean_signal);
+    float usable = highlight_demand * (1.0f - protection);
+    return clamp(
+        u_efficientCeilingNits +
+            (u_outputPeakNits - u_efficientCeilingNits) * usable,
+        u_efficientCeilingNits,
+        u_outputPeakNits);
+}
+
+void main()
+{
+    uint lane = gl_LocalInvocationIndex;
+    uint sample_count = u_gridExtent.x * u_gridExtent.y;
+    vec4 accum = vec4(0.0f);
+    vec4 extra = vec4(0.0f);
+
+    for (uint index = lane; index < sample_count; index += 128u)
+    {
+        uvec2 grid = uvec2(index % u_gridExtent.x, index / u_gridExtent.x);
+        vec2 display_coord =
+            ((vec2(grid) + vec2(0.5f)) / vec2(u_gridExtent)) *
+            vec2(u_displayExtent);
+        vec2 source_coord = (display_coord + u_offset) * u_scale;
+        bool inside = all(greaterThanEqual(source_coord, vec2(0.0f))) &&
+            all(lessThan(source_coord, vec2(u_sourceExtent)));
+        if (!inside)
+            continue;
+        vec2 uv = source_coord / vec2(u_sourceExtent);
+        vec4 sample_value = textureLod(s_samplers[0], uv, 0.0f);
+        float source_alpha =
+            u_sourceAlphaMode == 2u ? 1.0f : sample_value.a;
+        float coverage = clamp(source_alpha * u_opacity, 0.0f, 1.0f);
+        bool finite_sample =
+            !any(isnan(sample_value)) && !any(isinf(sample_value));
+        if (!finite_sample)
+        {
+            extra.z += 1.0f;
+            continue;
+        }
+        if (coverage <= 0.0f)
+            continue;
+
+        vec3 linear = decode_source(sample_value.rgb);
+        linear = (vec4(linear, 1.0f) * u_sourceCTM).rgb;
+        if (any(isnan(linear)) || any(isinf(linear)))
+        {
+            extra.z += 1.0f;
+            continue;
+        }
+        linear = (vec4(clamp(finite_nonnegative(linear), 0.0f, 1.0f), 1.0f) *
+            u_sourceTo2020).rgb;
+        if (any(isnan(linear)) || any(isinf(linear)))
+        {
+            extra.z += 1.0f;
+            continue;
+        }
+        // The production ITM clamps the post-sourceTo2020 channels before
+        // measuring luminance, so analysis uses the same domain.
+        linear = clamp(linear, 0.0f, 1.0f);
+        float y = clamp(dot(linear, k_bt2020), 0.0f, 1.0f);
+        if (isnan(y) || isinf(y))
+            continue;
+
+        float y2 = y * y;
+        float y4 = y2 * y2;
+        float y8 = y4 * y4;
+        accum.x += coverage * y;
+        accum.y += coverage * smooth_unit(
+            GAMESCOPE_AUTO_HDR_UPPER_BAND_START,
+            GAMESCOPE_AUTO_HDR_UPPER_BAND_FULL,
+            y);
+        accum.z = max(accum.z, y);
+        accum.w += coverage * smooth_unit(
+            GAMESCOPE_AUTO_HDR_BROAD_SAMPLE_START,
+            GAMESCOPE_AUTO_HDR_BROAD_SAMPLE_FULL,
+            y);
+        extra.x += coverage;
+        extra.y += coverage * y8;
+    }
+
+    s_accum[lane] = accum;
+    s_extra[lane] = extra;
+    barrier();
+
+    for (uint stride = 64u; stride > 0u; stride >>= 1u)
+    {
+        if (lane < stride)
+        {
+            s_accum[lane].xyw += s_accum[lane + stride].xyw;
+            s_accum[lane].z = max(s_accum[lane].z, s_accum[lane + stride].z);
+            s_extra[lane] += s_extra[lane + stride];
+        }
+        barrier();
+    }
+
+    if (lane != 0u)
+        return;
+
+    float valid_count = s_extra[0].x;
+    float valid_coverage = sample_count > 0u
+        ? valid_count / float(sample_count)
+        : 0.0f;
+    float denominator = max(valid_count, 1.0f);
+    float mean = clamp(s_accum[0].x / denominator, 0.0f, 1.0f);
+    float upper_occupancy = clamp(s_accum[0].y / denominator, 0.0f, 1.0f);
+    float power_mean = valid_count > 0.0f
+        ? pow(
+            max(s_extra[0].y / valid_count, 0.0f),
+            GAMESCOPE_AUTO_HDR_POWER_MEAN_EXPONENT)
+        : 0.0f;
+    float peak_confidence =
+        smooth_unit(
+            GAMESCOPE_AUTO_HDR_PEAK_CONFIDENCE_START,
+            GAMESCOPE_AUTO_HDR_PEAK_CONFIDENCE_FULL,
+            upper_occupancy);
+    float peak = clamp(
+        power_mean + peak_confidence * (s_accum[0].z - power_mean),
+        0.0f,
+        1.0f);
+    float broad_load = clamp(s_accum[0].w / denominator, 0.0f, 1.0f);
+    float desired = desired_ceiling(mean, upper_occupancy, peak, broad_load);
+
+    vec4 previous0 = texelFetch(
+        s_samplers[VKR_AUTO_HDR_STATE_SLOT], ivec2(0, 0), 0);
+    vec4 previous1 = texelFetch(
+        s_samplers[VKR_AUTO_HDR_STATE_SLOT], ivec2(1, 0), 0);
+    bool finite_state =
+        !any(isnan(previous0)) && !any(isinf(previous0)) &&
+        !any(isnan(previous1)) && !any(isinf(previous1));
+    bool valid_direction =
+        previous1.x == -1.0f ||
+        previous1.x == 0.0f ||
+        previous1.x == 1.0f;
+    bool valid_init = previous1.y == 0.0f || previous1.y == 1.0f;
+    bool valid_state = finite_state &&
+        previous0.x >= u_efficientCeilingNits &&
+        previous0.x <= u_outputPeakNits &&
+        previous0.y >= 0.0f && previous0.y <= 1.0f &&
+        previous0.z >= 0.0f && previous0.z <= 1.0f &&
+        previous0.w >= 0.0f &&
+        valid_direction &&
+        valid_init &&
+        previous1.z >= u_efficientCeilingNits &&
+        previous1.z <= u_outputPeakNits &&
+        previous1.w >= 0.0f && previous1.w <= 1.0f;
+    bool initialized = valid_state && previous1.y == 1.0f;
+
+    float content = initialized ? previous0.x : u_efficientCeilingNits;
+    float pending_seconds = initialized ? previous0.w : 0.0f;
+    float pending_direction = initialized ? previous1.x : 0.0f;
+    bool raw_invalid = s_extra[0].z > 0.0f;
+    if (raw_invalid)
+        desired = content;
+    else if (valid_coverage < GAMESCOPE_AUTO_HDR_MINIMUM_VALID_COVERAGE)
+        desired = u_efficientCeilingNits;
+    bool excessive_elapsed =
+        !isnan(u_elapsedSeconds) && !isinf(u_elapsedSeconds) &&
+        u_elapsedSeconds > GAMESCOPE_AUTO_HDR_MAXIMUM_ELAPSED_SECONDS;
+    bool freeze = u_reset != 0u || u_transitional != 0u ||
+        u_duplicated != 0u ||
+        raw_invalid ||
+        valid_coverage < GAMESCOPE_AUTO_HDR_MINIMUM_VALID_COVERAGE ||
+        isnan(u_elapsedSeconds) || isinf(u_elapsedSeconds) ||
+        u_elapsedSeconds <= 0.0f ||
+        u_elapsedSeconds > GAMESCOPE_AUTO_HDR_MAXIMUM_ELAPSED_SECONDS;
+    if (u_transitional != 0u ||
+        valid_coverage < GAMESCOPE_AUTO_HDR_MINIMUM_VALID_COVERAGE ||
+        raw_invalid || excessive_elapsed)
+    {
+        pending_seconds = 0.0f;
+        pending_direction = 0.0f;
+    }
+
+    float mean_cut_signal = initialized
+        ? smooth_unit(
+            GAMESCOPE_AUTO_HDR_SCENE_CUT_LOWER_FRACTION *
+                GAMESCOPE_AUTO_HDR_SCENE_CUT_MEAN_DELTA,
+            GAMESCOPE_AUTO_HDR_SCENE_CUT_MEAN_DELTA,
+            abs(mean - previous0.y))
+        : 0.0f;
+    float peak_cut_signal = initialized
+        ? smooth_unit(
+            GAMESCOPE_AUTO_HDR_SCENE_CUT_LOWER_FRACTION *
+                GAMESCOPE_AUTO_HDR_SCENE_CUT_PEAK_DELTA,
+            GAMESCOPE_AUTO_HDR_SCENE_CUT_PEAK_DELTA,
+            abs(peak - previous0.z))
+        : 0.0f;
+    float scene_cut_signal = max(mean_cut_signal, peak_cut_signal);
+    if (excessive_elapsed)
+    {
+        content = u_efficientCeilingNits;
+        desired = u_efficientCeilingNits;
+    }
+    bool cut_reduced = false;
+    if (!freeze && scene_cut_signal > 0.0f)
+    {
+        pending_seconds = 0.0f;
+        pending_direction = 0.0f;
+        if (desired < content)
+        {
+            content = clamp(
+                content + scene_cut_signal * (desired - content),
+                u_efficientCeilingNits,
+                u_outputPeakNits);
+            cut_reduced = true;
+        }
+    }
+    if (!freeze && !cut_reduced)
+    {
+        float difference = desired - content;
+        if (abs(difference) <= GAMESCOPE_AUTO_HDR_DEADBAND_NITS)
+        {
+            pending_seconds = 0.0f;
+            pending_direction = 0.0f;
+        }
+        else
+        {
+            float direction = difference < 0.0f ? -1.0f : 1.0f;
+            bool hysteresis_freeze =
+                pending_direction != 0.0f &&
+                direction != pending_direction &&
+                abs(difference) <=
+                    GAMESCOPE_AUTO_HDR_DEADBAND_NITS +
+                    GAMESCOPE_AUTO_HDR_DIRECTION_HYSTERESIS_NITS;
+            if (!hysteresis_freeze && direction != pending_direction)
+            {
+                pending_direction = direction;
+                pending_seconds = u_elapsedSeconds;
+            }
+            else if (!hysteresis_freeze)
+            {
+                pending_seconds += u_elapsedSeconds;
+            }
+
+            float dwell = direction < 0.0f
+                ? GAMESCOPE_AUTO_HDR_REDUCTION_DWELL_SECONDS
+                : GAMESCOPE_AUTO_HDR_RESTORATION_DWELL_SECONDS;
+            if (!hysteresis_freeze &&
+                direction == pending_direction && pending_seconds >= dwell)
+            {
+                float time_constant =
+                    direction < 0.0f
+                        ? GAMESCOPE_AUTO_HDR_REDUCTION_TIME_CONSTANT_SECONDS
+                        : GAMESCOPE_AUTO_HDR_RESTORATION_TIME_CONSTANT_SECONDS;
+                float blend = 1.0f - exp(-u_elapsedSeconds / time_constant);
+                content = clamp(
+                    content + blend * (desired - content),
+                    u_efficientCeilingNits,
+                    u_outputPeakNits);
+            }
+        }
+    }
+    else if (u_reset != 0u)
+    {
+        content = u_efficientCeilingNits;
+        pending_seconds = 0.0f;
+        pending_direction = 0.0f;
+    }
+
+    bool preserve_history =
+        freeze && initialized && u_reset == 0u && !excessive_elapsed;
+    float stored_mean = preserve_history ? previous0.y : mean;
+    float stored_peak = preserve_history ? previous0.z : peak;
+    imageStore(u_nextState, ivec2(0, 0),
+        vec4(content, stored_mean, stored_peak, pending_seconds));
+    imageStore(u_nextState, ivec2(1, 0),
+        vec4(
+            pending_direction,
+            excessive_elapsed
+                ? 0.0f
+                : (freeze && initialized && u_reset == 0u
+                    ? previous1.y
+                    : 1.0f),
+            desired,
+            valid_coverage));
+}
