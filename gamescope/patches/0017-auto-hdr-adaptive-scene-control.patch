+	uint32_t sourceLayer = 0;
+	while ( sourceLayer < 32u &&
+			( frameInfo->autoHDRLayerMask & ( 1u << sourceLayer ) ) == 0u )
+		sourceLayer++;
+	if ( sourceLayer >= uint32_t( frameInfo->layerCount ) )
+		return false;
