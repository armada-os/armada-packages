+	int failures = 0;
+
+	void check( bool condition, std::string_view message )
+	{
+		if ( condition )
+			return;
+		std::cerr << "FAIL: " << message << '\n';
+		failures++;
+	}
+
+	void near( double actual, double expected, double tolerance, std::string_view message )
+	{
+		if ( std::isfinite( actual ) && std::abs( actual - expected ) <= tolerance )
+			return;
+		std::cerr << "FAIL: " << message << " (actual=" << actual << ", expected=" << expected << ")\n";
+		failures++;
+	}
+
+	bool finiteAndBounded( const RGB &value, double peak )
+	{
+		return std::isfinite( value.r ) && std::isfinite( value.g ) && std::isfinite( value.b ) &&
+			value.r >= 0.0 && value.g >= 0.0 && value.b >= 0.0 &&
+			value.r <= peak && value.g <= peak && value.b <= peak;
+	}
+
+	double neutralNits( double level, const Config &config )
+	{
+		const auto mapped = gamescope::autohdr::efficientInverseToneMap( { level, level, level }, config );
+		return mapped ? mapped->r : std::numeric_limits<double>::quiet_NaN();
+	}
+}
+
+int main()
+{
+	using namespace gamescope::autohdr;
+
+	near( srgbDecode( 0.0 ), 0.0, 0.0, "sRGB black" );
+	near( srgbDecode( 0.04045 ), 0.00313080495356037, 1e-15, "sRGB linear segment boundary" );
+	near( srgbDecode( 0.5 ), 0.214041140482233, 1e-14, "sRGB 0.5 decode" );
+	near( srgbDecode( 1.0 ), 1.0, 0.0, "sRGB white" );
+
+	const RGB neutral2020 = rec709ToRec2020( { 0.37, 0.37, 0.37 } );
+	near( neutral2020.r, 0.37, 2e-15, "Rec.709 to Rec.2020 neutral red" );
+	near( neutral2020.g, 0.37, 2e-15, "Rec.709 to Rec.2020 neutral green" );
+	near( neutral2020.b, 0.37, 2e-15, "Rec.709 to Rec.2020 neutral blue" );
+	const RGB red2020 = rec709ToRec2020( { 1.0, 0.0, 0.0 } );
+	near( red2020.r, 0.627403895934699, 1e-15, "Rec.709 red matrix R" );
+	near( red2020.g, 0.069097289358232, 1e-15, "Rec.709 red matrix G" );
+	near( red2020.b, 0.016391438875150, 1e-15, "Rec.709 red matrix B" );
+
+	near( pqEncodeNits( 0.0 ), 7.30955902578397e-7, 1e-18, "PQ code for zero nits" );
+	near( pqEncodeNits( 80.0 ), 0.4858567653886785, 1e-14, "PQ code for 80 nits" );
+	near( pqEncodeNits( 100.0 ), 0.508078421517399, 1e-14, "PQ code for 100 nits" );
+	near( pqEncodeNits( 203.0 ), 0.5806888810416109, 1e-14, "PQ code for 203 nits" );
+	near( pqEncodeNits( 650.0 ), 0.7049692700077218, 1e-14, "PQ code for 650 nits" );
+	near( pqEncodeNits( 1000.0 ), 0.751827096247041, 1e-14, "PQ code for 1000 nits" );
+	near( pqEncodeNits( 10000.0 ), 1.0, 1e-14, "PQ code for 10000 nits" );
+	near( pqDecodeNits( pqEncodeNits( 650.0 ) ), 650.0, 1e-9, "PQ 650-nit round trip" );
+	near( nitsToScRGB( 650.0 ), 8.125, 0.0, "nits-to-scRGB divide by 80" );
+	near( scRGBToNits( nitsToScRGB( 650.0 ) ), 650.0, 0.0, "scRGB handoff round trip" );
+	near( pqEncodeNits( scRGBToNits( nitsToScRGB( 650.0 ) ) ), pqEncodeNits( 650.0 ), 0.0,
+		"scRGB handoff reaches PQ without a second light-scale conversion" );
+
+	check( validConfig( { 100.0, 650.0 } ), "100/650 config valid" );
+	check( validConfig( { 100.0, 1000.0 } ), "100/1000 config valid" );
+	check( validConfig( { 203.0, 650.0 } ), "203/650 config valid" );
+	check( validConfig( { 203.0, 203.0 } ), "equal reference and target valid" );
+	check( !validConfig( { 0.0, 650.0 } ), "zero SDR reference rejected" );
+	check( !validConfig( { 650.0, 203.0 } ), "peak below SDR reference rejected" );
+	check( !validConfig( { 100.0, 10001.0 } ), "peak above PQ range rejected" );
+	check( !validConfig( { std::numeric_limits<double>::quiet_NaN(), 650.0 } ), "nonfinite config rejected" );
+	check( !efficientInverseToneMap( { 1.0, 1.0, 1.0 }, { 0.0, 650.0 } ), "invalid config fails closed" );
+
+	constexpr Config odinConfig{ 203.0, 650.0 };
+	const std::array<std::pair<double, double>, 9> neutralGolden = {{
+		{ 0.00, 0.0000 },
+		{ 0.01, 2.0300 },
+		{ 0.18, 36.5400 },
+		{ 0.50, 101.5000 },
+		{ 0.60, 121.8000 },
+		{ 0.70, 148.6975 },
+		{ 0.80, 188.7900 },
+		{ 0.90, 242.0775 },
+		{ 1.00, 308.5600 },
+	}};
+	for ( const auto &[input, expected] : neutralGolden )
+		near( neutralNits( input, odinConfig ), expected, 1e-9, "Odin efficient neutral golden" );
+
+	// The low and middle range is exactly the unexpanded display-light path.
+	for ( int step = 0; step <= 600; step++ )
+	{
+		const double level = step / 1000.0;
+		near( neutralNits( level, odinConfig ), odinConfig.sdrNits * level, 1e-10,
+			"Odin efficient shadows and mid-tones unchanged" );
+	}
+
+	// The independently derived quadratic is C1 at the 0.60 knee.
+	constexpr double knee = 0.60;
+	constexpr double epsilon = 1e-6;
+	const double leftSlope = ( neutralNits( knee, odinConfig ) - neutralNits( knee - epsilon, odinConfig ) ) / epsilon;
+	const double rightSlope = ( neutralNits( knee + epsilon, odinConfig ) - neutralNits( knee, odinConfig ) ) / epsilon;
+	near( leftSlope, odinConfig.sdrNits, 1e-7, "Odin efficient left knee slope" );
+	near( rightSlope, odinConfig.sdrNits, 1e-3, "Odin efficient right knee slope" );
+
+	for ( const Config config : { Config{ 100.0, 650.0 }, Config{ 100.0, 1000.0 }, odinConfig } )
+	{
+		const auto black = efficientInverseToneMap( { 0.0, 0.0, 0.0 }, config );
+		check( black.has_value(), "black conversion accepted" );
+		if ( black )
+		{
+			near( black->r, 0.0, 0.0, "exact black red" );
+			near( black->g, 0.0, 0.0, "exact black green" );
+			near( black->b, 0.0, 0.0, "exact black blue" );
+		}
+
+		double previous = -1.0;
+		for ( int step = 0; step <= 4096; step++ )
+		{
+			const double level = step / 4096.0;
+			const auto output = efficientInverseToneMap( { level, level, level }, config );
+			check( output.has_value(), "dense neutral conversion accepted" );
+			if ( !output )
+				continue;
+			check( finiteAndBounded( *output, config.targetNits ), "dense neutral finite and bounded" );
+			check( output->r + 1e-10 >= previous, "dense neutral monotonic" );
+			near( output->r, output->g, 2e-9, "neutral R/G preserved" );
+			near( output->g, output->b, 2e-9, "neutral G/B preserved" );
+			previous = output->r;
+		}
+
+		for ( int r = 0; r <= 16; r++ )
+			for ( int g = 0; g <= 16; g++ )
+				for ( int b = 0; b <= 16; b++ )
+				{
+					const auto output = efficientInverseToneMap(
+						{ r / 16.0, g / 16.0, b / 16.0 }, config );
+					check( output.has_value(), "dense RGB conversion accepted" );
+					if ( output )
+						check( finiteAndBounded( *output, config.targetNits ), "dense RGB finite and bounded" );
+				}
+	}
+
+	const auto red = efficientInverseToneMap( { 1.0, 0.0, 0.0 }, odinConfig );
+	check( red.has_value(), "saturated red conversion accepted" );
+	if ( red )
+	{
+		near( red->r, 203.0, 1e-12, "below-knee red follows baseline" );
+		near( red->g, 0.0, 0.0, "red green remains zero" );
+		near( red->b, 0.0, 0.0, "red blue remains zero" );
+	}
+	const auto saturated = efficientInverseToneMap( { 1.0, 0.0, 1.0 }, odinConfig );
+	check( saturated.has_value() && finiteAndBounded( *saturated, odinConfig.targetNits ),
+		"Odin saturated input finite and bounded" );
+
+	const RGB chromaticInput{ 0.8, 0.6, 0.2 };
+	const auto chromatic = efficientInverseToneMap( chromaticInput, odinConfig );
+	check( chromatic.has_value(), "chromatic conversion accepted" );
+	if ( chromatic )
+	{
+		near( chromatic->r / chromatic->g, chromaticInput.r / chromaticInput.g, 1e-12,
+			"common luminance scale preserves R/G ratio" );
+		near( chromatic->g / chromatic->b, chromaticInput.g / chromaticInput.b, 1e-12,
+			"common luminance scale preserves G/B ratio" );
+	}
+
+	// A low target remains a strict cap and smoothly reduces highlight expansion.
+	const auto cappedWhite = efficientInverseToneMap( { 1.0, 1.0, 1.0 }, { 203.0, 250.0 } );
+	check( cappedWhite.has_value(), "low-target white accepted" );
+	if ( cappedWhite )
+		near( cappedWhite->r, 250.0, 1e-10, "low target caps white" );
+	const auto unexpandedWhite = efficientInverseToneMap( { 1.0, 1.0, 1.0 }, { 203.0, 203.0 } );
+	check( unexpandedWhite.has_value(), "equal-target white accepted" );
+	if ( unexpandedWhite )
+		near( unexpandedWhite->r, 203.0, 1e-10, "equal target disables expansion" );
+
+	const RGBA encodedInput{ 0.5, 0.25, 0.75, 0.37123456789 };
+	const auto converted = convertSRGBToHDRNits( encodedInput, odinConfig );
+	check( converted.has_value(), "RGBA conversion accepted" );
+	if ( converted )
+	{
+		near( converted->a, encodedInput.a, 0.0, "alpha preserved exactly" );
+		check( finiteAndBounded( { converted->r, converted->g, converted->b }, odinConfig.targetNits ),
+			"RGBA output finite and bounded" );
+	}
+
+	const auto hostile = convertSRGBToHDRNits(
+		{ -1.0, std::numeric_limits<double>::infinity(), std::numeric_limits<double>::quiet_NaN(), 0.5 },
+		odinConfig );
+	check( hostile.has_value(), "hostile RGB input safely handled" );
+	if ( hostile )
+	{
+		near( hostile->r, 0.0, 0.0, "negative input clamps to black" );
+		near( hostile->g, 0.0, 0.0, "infinite input clamps to black" );
+		near( hostile->b, 0.0, 0.0, "NaN input clamps to black" );
+		near( hostile->a, 0.5, 0.0, "hostile alpha preserved" );
+	}
+
+	const RGBA generalInput{ 0.5, 0.25, 0.75, 0.37123456789 };
+	const auto generalConverted = convertSRGBToHDRNits( generalInput, { 100.0, 650.0 } );
+	check( generalConverted.has_value(), "100/650 RGBA conversion accepted" );
+	if ( generalConverted )
+	{
+		near( generalConverted->a, generalInput.a, 0.0, "100/650 alpha preserved exactly" );
+		check( finiteAndBounded( { generalConverted->r, generalConverted->g, generalConverted->b }, 650.0 ),
+			"100/650 RGBA output finite and bounded" );
+	}
+
+	const auto generalHostile = convertSRGBToHDRNits(
+		{ -1.0, std::numeric_limits<double>::infinity(), std::numeric_limits<double>::quiet_NaN(), 0.75 },
+		{ 100.0, 650.0 } );
+	check( generalHostile.has_value(), "100/650 hostile input safely handled" );
+	if ( generalHostile )
+	{
+		near( generalHostile->r, 0.0, 0.0, "100/650 hostile red clamps to black" );
+		near( generalHostile->g, 0.0, 0.0, "100/650 hostile green clamps to black" );
+		near( generalHostile->b, 0.0, 0.0, "100/650 hostile blue clamps to black" );
+		near( generalHostile->a, 0.75, 0.0, "100/650 hostile alpha preserved" );
+	}
+
+	if ( failures != 0 )
+	{
+		std::cerr << failures << " Auto HDR color reference test(s) failed\n";
+		return EXIT_FAILURE;
+	}
+
+	std::cout << "Auto HDR color reference tests passed\n";
+	return EXIT_SUCCESS;
+}
diff --git a/tests/test_auto_hdr_policy.cpp b/tests/test_auto_hdr_policy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e0ff7200e2ddb56be6f5c0a7577b5a56b231ed5d
--- /dev/null
+++ b/tests/test_auto_hdr_policy.cpp
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#include "AutoHDRPolicy.h"
+
+#include <cstdlib>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <array>
+#include <string_view>
+#include <utility>
+
+using gamescope::autohdr::PolicyInput;
+using gamescope::autohdr::PolicyReason;
+using gamescope::autohdr::PolicyResult;
+
+namespace
+{
+	int failures = 0;
+
+	void check( bool condition, std::string_view message )
+	{
+		if ( condition )
+			return;
+		std::cerr << "FAIL: " << message << '\n';
+		failures++;
+	}
+
+	PolicyInput validInput()
+	{
+		PolicyInput input;
+		input.requested = true;
+		input.hdrOutputActive = true;
+		input.outputQualified = true;
+		input.calibrationAvailable = true;
+		input.colorManagementReady = true;
+		input.sdrReferenceNits = 203.0;
+		input.targetNits = 650.0;
+		input.calibratedOutputPeakNits = 650.0;
+		input.activeLayerCount = 1;
+		input.layers[0] = { true, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB };
+		return input;
+	}
+
+	void expectStopped( const PolicyInput &input, PolicyReason reason, std::string_view message )
+	{
+		const PolicyResult result = gamescope::autohdr::evaluatePolicy( input );
+		check( result.layerMask == 0, message );
+		check( result.reason == reason, message );
+		check( !result.requiresComposition(), message );
+	}
+}
+
+int main()
+{
+	{
+		PolicyInput input = validInput();
+		input.requested = false;
+		expectStopped( input, PolicyReason::RequestDisabled, "request off" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.hdrOutputActive = false;
+		expectStopped( input, PolicyReason::HDROutputInactive, "HDR output off" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.outputQualified = false;
+		expectStopped( input, PolicyReason::OutputUnqualified, "unqualified output" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.calibrationAvailable = false;
+		expectStopped( input, PolicyReason::CalibrationUnavailable, "calibration unavailable" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.colorManagementReady = false;
+		expectStopped( input, PolicyReason::ColorManagementNotReady, "color management not ready" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.steamOrSystemUIFocused = true;
+		expectStopped( input, PolicyReason::SteamOrSystemUIFocused, "Steam or system UI focused" );
+	}
+
+	for ( const double bad : { std::numeric_limits<double>::quiet_NaN(),
+			std::numeric_limits<double>::infinity(), -1.0, 0.0 } )
+	{
+		PolicyInput input = validInput();
+		input.sdrReferenceNits = bad;
+		expectStopped( input, PolicyReason::InvalidConfiguration, "invalid SDR reference" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.targetNits = std::numeric_limits<double>::quiet_NaN();
+		expectStopped( input, PolicyReason::InvalidConfiguration, "NaN target" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.targetNits = std::numeric_limits<double>::infinity();
+		expectStopped( input, PolicyReason::InvalidConfiguration, "infinite target" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.targetNits = 100.0;
+		expectStopped( input, PolicyReason::InvalidConfiguration, "target below SDR reference" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.targetNits = 651.0;
+		expectStopped( input, PolicyReason::InvalidConfiguration, "target above calibrated peak" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.calibratedOutputPeakNits = std::numeric_limits<double>::infinity();
+		expectStopped( input, PolicyReason::InvalidConfiguration, "infinite calibrated peak" );
+	}
+
+	{
+		PolicyInput input = validInput();
+		input.activeLayerCount = 3;
+		input.layers[0] = { true, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB };
+		input.layers[1] = { false, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB };
+		input.layers[2] = { false, GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR };
+		const PolicyResult result = gamescope::autohdr::evaluatePolicy( input );
+		check( result.layerMask == 0x1u, "SDR base selected while overlay and cursor bypass" );
+		check( result.reason == PolicyReason::Enabled, "eligible SDR reason" );
+		check( result.requiresComposition(), "eligible SDR requires composition" );
+	}
+
+	for ( const GamescopeAppTextureColorspace colorspace : {
+			GAMESCOPE_APP_TEXTURE_COLORSPACE_SCRGB,
+			GAMESCOPE_APP_TEXTURE_COLORSPACE_HDR10_PQ,
+			GAMESCOPE_APP_TEXTURE_COLORSPACE_PASSTHRU } )
+	{
+		PolicyInput input = validInput();
+		input.layers[0].colorspace = colorspace;
+		expectStopped( input, PolicyReason::NoEligibleLayers, "HDR or passthrough input bypass" );
+	}
+
+	{
+		PolicyInput input = validInput();
+		input.activeLayerCount = 6;
+		input.layers[0] = { true, GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR };
+		input.layers[1] = { false, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB };
+		input.layers[2] = { true, GAMESCOPE_APP_TEXTURE_COLORSPACE_HDR10_PQ };
+		input.layers[3] = { true, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB };
+		input.layers[4] = { true, static_cast<GamescopeAppTextureColorspace>( 99 ) };
+		input.layers[5] = { false, GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR };
+		const PolicyResult result = gamescope::autohdr::evaluatePolicy( input );
+		check( result.layerMask == 0x9u, "only explicit SDR scene candidates selected" );
+		check( result.reason == PolicyReason::Enabled, "mixed layer reason" );
+		check( ( result.layerMask >> input.activeLayerCount ) == 0u, "mask bounded by active layers" );
+	}
+
+	{
+		PolicyInput input = validInput();
+		input.activeLayerCount = 32;
+		for ( uint32_t i = 0; i < input.activeLayerCount; i++ )
+			input.layers[i] = { true, GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB };
+		const PolicyResult result = gamescope::autohdr::evaluatePolicy( input );
+		check( result.layerMask == std::numeric_limits<uint32_t>::max(), "all 32 active layers represented" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.activeLayerCount = 0;
+		expectStopped( input, PolicyReason::InvalidLayerCount, "zero active layers" );
+	}
+	{
+		PolicyInput input = validInput();
+		input.activeLayerCount = 33;
+		expectStopped( input, PolicyReason::InvalidLayerCount, "more than 32 active layers" );
+	}
+
+	check( static_cast<uint8_t>( PolicyReason::Enabled ) == 0, "stable Enabled reason value" );
+	check( static_cast<uint8_t>( PolicyReason::NoEligibleLayers ) == 9, "stable NoEligibleLayers reason value" );
+
+	constexpr std::array reasonNames = {
+		std::pair{ PolicyReason::Enabled, std::string_view{ "enabled" } },
+		std::pair{ PolicyReason::RequestDisabled, std::string_view{ "request-disabled" } },
+		std::pair{ PolicyReason::HDROutputInactive, std::string_view{ "hdr-output-inactive" } },
+		std::pair{ PolicyReason::OutputUnqualified, std::string_view{ "output-unqualified" } },
+		std::pair{ PolicyReason::CalibrationUnavailable, std::string_view{ "calibration-unavailable" } },
+		std::pair{ PolicyReason::ColorManagementNotReady, std::string_view{ "color-management-not-ready" } },
+		std::pair{ PolicyReason::SteamOrSystemUIFocused, std::string_view{ "steam-or-system-ui-focused" } },
+		std::pair{ PolicyReason::InvalidLayerCount, std::string_view{ "invalid-layer-count" } },
+		std::pair{ PolicyReason::InvalidConfiguration, std::string_view{ "invalid-configuration" } },
+		std::pair{ PolicyReason::NoEligibleLayers, std::string_view{ "no-eligible-layers" } },
+	};
+	for ( const auto &[reason, name] : reasonNames )
+		check( gamescope::autohdr::policyReasonName( reason ) == name, "policy reason name" );
+	check( gamescope::autohdr::policyReasonName( static_cast<PolicyReason>( 255 ) ) == "unknown",
+		"unknown policy reason name" );
+
+	if ( failures != 0 )
+		return EXIT_FAILURE;
+	std::cout << "Auto HDR policy tests passed\n";
+	return EXIT_SUCCESS;
+}
