diff --git a/src/AutoHDRColor.cpp b/src/AutoHDRColor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..832ec72992750c2cbddd60d58f1d307cb5df37f9
--- /dev/null
+++ b/src/AutoHDRColor.cpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#include "AutoHDRColor.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace gamescope::autohdr
+{
+	namespace
+	{
+		constexpr double kScRGBLightScale = 80.0;
+		constexpr double kBT2020R = 0.262698338956556;
+		constexpr double kBT2020G = 0.678008765772817;
+		constexpr double kBT2020B = 0.0592928952706273;
+		double finiteNonNegative( double value )
+		{
+			return std::isfinite( value ) ? std::max( value, 0.0 ) : 0.0;
+		}
+
+		double bounded( double value, double upper )
+		{
+			return std::clamp( finiteNonNegative( value ), 0.0, upper );
+		}
+
+		RGB bounded( const RGB &value, double upper )
+		{
+			return {
+				bounded( value.r, upper ),
+				bounded( value.g, upper ),
+				bounded( value.b, upper ),
+			};
+		}
+
+		bool finite( const RGB &value )
+		{
+			return std::isfinite( value.r ) && std::isfinite( value.g ) && std::isfinite( value.b );
+		}
+	}
+
+	bool validConfig( const Config &config )
+	{
+		return std::isfinite( config.sdrNits ) &&
+			std::isfinite( config.targetNits ) &&
+			config.sdrNits > 0.0 &&
+			config.targetNits >= config.sdrNits &&
+			config.targetNits <= 10000.0;
+	}
+
+	double srgbDecode( double encoded )
+	{
+		// IEC 61966-2-1 sRGB electro-optical transfer function.
+		encoded = bounded( encoded, 1.0 );
+		return encoded <= 0.04045
+			? encoded / 12.92
+			: std::pow( ( encoded + 0.055 ) / 1.055, 2.4 );
+	}
+
+	RGB srgbDecode( const RGB &encoded )
+	{
+		return { srgbDecode( encoded.r ), srgbDecode( encoded.g ), srgbDecode( encoded.b ) };
+	}
+
+	RGB rec709ToRec2020( const RGB &linearRec709 )
+	{
+		// Linear-light BT.709 to BT.2020, derived from the standard primaries
+		// with their shared D65 white point.
+		const RGB input = bounded( linearRec709, 1.0 );
+		return {
+			0.627403895934699 * input.r + 0.329283038377883 * input.g + 0.043313065687418 * input.b,
+			0.069097289358232 * input.r + 0.919540395075459 * input.g + 0.011362315566309 * input.b,
+			0.016391438875150 * input.r + 0.088013307877226 * input.g + 0.895595253247624 * input.b,
+		};
+	}
+
+	double pqEncodeNits( double nits )
+	{
+		// SMPTE ST 2084 perceptual quantizer, absolute luminance in cd/m2.
+		constexpr double c1 = 0.8359375;
+		constexpr double c2 = 18.8515625;
+		constexpr double c3 = 18.6875;
+		constexpr double m1 = 0.1593017578125;
+		constexpr double m2 = 78.84375;
+
+		const double normalized = bounded( nits, 10000.0 ) / 10000.0;
+		const double powered = std::pow( normalized, m1 );
+		return std::pow( ( c1 + c2 * powered ) / ( 1.0 + c3 * powered ), m2 );
+	}
+
+	double pqDecodeNits( double pq )
+	{
+		// SMPTE ST 2084 inverse EOTF, returning absolute cd/m2.
+		constexpr double c1 = 0.8359375;
+		constexpr double c2 = 18.8515625;
+		constexpr double c3 = 18.6875;
+		constexpr double inverseM1 = 1.0 / 0.1593017578125;
+		constexpr double inverseM2 = 1.0 / 78.84375;
+
+		pq = bounded( pq, 1.0 );
+		const double powered = std::pow( pq, inverseM2 );
+		const double numerator = std::max( powered - c1, 0.0 );
+		const double denominator = c2 - c3 * powered;
+		if ( denominator <= 0.0 )
+			return 10000.0;
+		return bounded( 10000.0 * std::pow( numerator / denominator, inverseM1 ), 10000.0 );
+	}
+
+	double nitsToScRGB( double nits )
+	{
+		return bounded( nits, 10000.0 ) / kScRGBLightScale;
+	}
+
+	double scRGBToNits( double scRGB )
+	{
+		return bounded( scRGB, 10000.0 / kScRGBLightScale ) * kScRGBLightScale;
+	}
+
+	std::optional<RGB> efficientInverseToneMap( const RGB &linearRec2020, const Config &config )
+	{
+		// Conservative global highlight expansion following the design guidance
+		// in Rep. ITU-R BT.2446-1 section 5.1: preserve display-light shadows and
+		// mid-tones, begin expansion near 60% linear luminance, and limit the
+		// highlight multiplier to 2.3. The quadratic blend is independently
+		// derived so its value and first derivative match the unexpanded segment
+		// at the knee.
+		if ( !validConfig( config ) )
+			return std::nullopt;
+
+		const RGB color = bounded( linearRec2020, 1.0 );
+		if ( color.r == 0.0 && color.g == 0.0 && color.b == 0.0 )
+			return RGB{};
+
+		constexpr double highlightKnee = 0.60;
+		constexpr double highlightMultiplier = 2.30;
+		const double luminance = kBT2020R * color.r + kBT2020G * color.g + kBT2020B * color.b;
+		if ( luminance <= 0.0 || !std::isfinite( luminance ) )
+			return RGB{};
+
+		const double expandedWhite = config.sdrNits *
+			( highlightKnee + highlightMultiplier * ( 1.0 - highlightKnee ) );
+		const double mappedWhite = std::min( config.targetNits, expandedWhite );
+		double mappedLuminance = config.sdrNits * luminance;
+		if ( luminance > highlightKnee && mappedWhite > config.sdrNits )
+		{
+			const double t = ( luminance - highlightKnee ) / ( 1.0 - highlightKnee );
+			mappedLuminance += ( mappedWhite - config.sdrNits ) * t * t;
+		}
+
+		const double scale = mappedLuminance / luminance;
+		RGB mapped = { color.r * scale, color.g * scale, color.b * scale };
+		const double maxChannel = std::max( { mapped.r, mapped.g, mapped.b } );
+		if ( maxChannel > config.targetNits )
+		{
+			const double peakScale = config.targetNits / maxChannel;
+			mapped = { mapped.r * peakScale, mapped.g * peakScale, mapped.b * peakScale };
+		}
+
+		return finite( mapped ) ? std::optional<RGB>{ bounded( mapped, config.targetNits ) } : std::nullopt;
+	}
+
+	std::optional<RGBA> convertSRGBToHDRNits( const RGBA &encodedRec709, const Config &config )
+	{
+		const RGB decoded = srgbDecode( { encodedRec709.r, encodedRec709.g, encodedRec709.b } );
+		const auto mapped = efficientInverseToneMap( rec709ToRec2020( decoded ), config );
+		if ( !mapped )
+			return std::nullopt;
+		return RGBA{ mapped->r, mapped->g, mapped->b, encodedRec709.a };
+	}
+}
