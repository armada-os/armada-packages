+// SPDX-License-Identifier: BSD-2-Clause
+
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace gamescope::autohdr
+{
+	inline constexpr std::string_view SupportedAtomName = "GAMESCOPE_HDR_ITM_SUPPORTED";
+	inline constexpr std::string_view EnableAtomName = "GAMESCOPE_HDR_ITM_ENABLE";
+	inline constexpr std::string_view ActiveFeedbackAtomName = "GAMESCOPE_AUTO_HDR_ACTIVE_FEEDBACK";
+
+	struct RootPropertyValues
+	{
+		uint32_t supported;
+		uint32_t enabled;
+		uint32_t active;
+	};
+
+	constexpr RootPropertyValues initialRootPropertyValues( bool enabled )
+	{
+		return { 1u, enabled ? 1u : 0u, 0u };
+	}
+
+	constexpr bool activeFromLayerMask( uint32_t layerMask )
+	{
+		return layerMask != 0u;
+	}
+
+	constexpr bool presentationWantsHDR( bool nativeHDR, bool autoHDRActive )
+	{
+		return nativeHDR || autoHDRActive;
+	}
+}
