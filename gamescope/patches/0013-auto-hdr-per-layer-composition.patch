+// SPDX-License-Identifier: BSD-2-Clause
+
+#pragma once
+
+#include <optional>
+
+namespace gamescope::autohdr
+{
+	struct RGB
+	{
+		double r;
+		double g;
+		double b;
+	};
+
+	struct RGBA
+	{
+		double r;
+		double g;
+		double b;
+		double a;
+	};
+
+	struct Config
+	{
+		double sdrNits;
+		double targetNits;
+	};
+
+	bool validConfig( const Config &config );
+
+	double srgbDecode( double encoded );
+	RGB srgbDecode( const RGB &encoded );
+	RGB rec709ToRec2020( const RGB &linearRec709 );
+
+	double pqEncodeNits( double nits );
+	double pqDecodeNits( double pq );
+	double nitsToScRGB( double nits );
+	double scRGBToNits( double scRGB );
+
+	std::optional<RGB> efficientInverseToneMap( const RGB &linearRec2020, const Config &config );
+	std::optional<RGBA> convertSRGBToHDRNits( const RGBA &encodedRec709, const Config &config );
+}
diff --git a/src/AutoHDRPolicy.cpp b/src/AutoHDRPolicy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..adbba2a643fcfcf3810146e1325737c7c92b3514
--- /dev/null
+++ b/src/AutoHDRPolicy.cpp
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#include "AutoHDRPolicy.h"
+
+#include <bit>
+
+namespace gamescope::autohdr
+{
+	namespace
+	{
+		bool isFinite( double value )
+		{
+			constexpr uint64_t exponentMask = UINT64_C( 0x7ff0000000000000 );
+			return ( std::bit_cast<uint64_t>( value ) & exponentMask ) != exponentMask;
+		}
+
+		bool validConfiguration( const PolicyInput &input )
+		{
+			return isFinite( input.sdrReferenceNits ) &&
+				isFinite( input.targetNits ) &&
+				isFinite( input.calibratedOutputPeakNits ) &&
+				input.sdrReferenceNits > 0.0 &&
+				input.targetNits >= input.sdrReferenceNits &&
+				input.calibratedOutputPeakNits > 0.0 &&
+				input.targetNits <= input.calibratedOutputPeakNits;
+		}
+
+		bool isExplicitSDR( GamescopeAppTextureColorspace colorspace )
+		{
+			return colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR ||
+				colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB;
+		}
+	}
+
+	std::string_view policyReasonName( PolicyReason reason ) noexcept
+	{
+		switch ( reason )
+		{
+			case PolicyReason::Enabled: return "enabled";
+			case PolicyReason::RequestDisabled: return "request-disabled";
+			case PolicyReason::HDROutputInactive: return "hdr-output-inactive";
+			case PolicyReason::OutputUnqualified: return "output-unqualified";
+			case PolicyReason::CalibrationUnavailable: return "calibration-unavailable";
+			case PolicyReason::ColorManagementNotReady: return "color-management-not-ready";
+			case PolicyReason::SteamOrSystemUIFocused: return "steam-or-system-ui-focused";
+			case PolicyReason::InvalidLayerCount: return "invalid-layer-count";
+			case PolicyReason::InvalidConfiguration: return "invalid-configuration";
+			case PolicyReason::NoEligibleLayers: return "no-eligible-layers";
+		}
+		return "unknown";
+	}
+
+	PolicyResult evaluatePolicy( const PolicyInput &input )
+	{
+		if ( !input.requested )
+			return { 0, PolicyReason::RequestDisabled };
+		if ( !input.hdrOutputActive )
+			return { 0, PolicyReason::HDROutputInactive };
+		if ( !input.outputQualified )
+			return { 0, PolicyReason::OutputUnqualified };
+		if ( !input.calibrationAvailable )
+			return { 0, PolicyReason::CalibrationUnavailable };
+		if ( !input.colorManagementReady )
+			return { 0, PolicyReason::ColorManagementNotReady };
+		if ( input.steamOrSystemUIFocused )
+			return { 0, PolicyReason::SteamOrSystemUIFocused };
+		if ( input.activeLayerCount == 0 || input.activeLayerCount > MaxPolicyLayers )
+			return { 0, PolicyReason::InvalidLayerCount };
+		if ( !validConfiguration( input ) )
+			return { 0, PolicyReason::InvalidConfiguration };
+
+		uint32_t mask = 0;
+		for ( uint32_t layer = 0; layer < input.activeLayerCount; layer++ )
+		{
+			const LayerState &state = input.layers[layer];
+			if ( state.sceneCandidate && isExplicitSDR( state.colorspace ) )
+				mask |= uint32_t{ 1 } << layer;
+		}
+
+		if ( mask == 0 )
+			return { 0, PolicyReason::NoEligibleLayers };
+		return { mask, PolicyReason::Enabled };
+	}
+}
diff --git a/src/AutoHDRPolicy.h b/src/AutoHDRPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..cdab36595cfe13a60a7e32e3de706813989d3a1b
--- /dev/null
+++ b/src/AutoHDRPolicy.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#pragma once
+
+#include "gamescope_shared.h"
+
+#include <array>
+#include <cstdint>
+#include <string_view>
+
+namespace gamescope::autohdr
+{
+	constexpr uint32_t MaxPolicyLayers = 32;
+
+	enum class PolicyReason : uint8_t
+	{
+		Enabled = 0,
+		RequestDisabled = 1,
+		HDROutputInactive = 2,
+		OutputUnqualified = 3,
+		CalibrationUnavailable = 4,
+		ColorManagementNotReady = 5,
+		SteamOrSystemUIFocused = 6,
+		InvalidLayerCount = 7,
+		InvalidConfiguration = 8,
+		NoEligibleLayers = 9,
+	};
+
+	struct LayerState
+	{
+		bool sceneCandidate = false;
+		GamescopeAppTextureColorspace colorspace = GAMESCOPE_APP_TEXTURE_COLORSPACE_PASSTHRU;
+	};
+
+	struct PolicyInput
+	{
+		bool requested = false;
+		bool hdrOutputActive = false;
+		bool outputQualified = false;
+		bool calibrationAvailable = false;
+		bool colorManagementReady = false;
+		bool steamOrSystemUIFocused = false;
+
+		double sdrReferenceNits = 0.0;
+		double targetNits = 0.0;
+		double calibratedOutputPeakNits = 0.0;
+
+		uint32_t activeLayerCount = 0;
+		std::array<LayerState, MaxPolicyLayers> layers = {};
+	};
+
+	struct PolicyResult
+	{
+		uint32_t layerMask = 0;
+		PolicyReason reason = PolicyReason::RequestDisabled;
+
+		constexpr bool requiresComposition() const
+		{
+			return layerMask != 0;
+		}
+	};
+
+	std::string_view policyReasonName( PolicyReason reason ) noexcept;
+	PolicyResult evaluatePolicy( const PolicyInput &input );
+}
