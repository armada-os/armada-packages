+				std::isfinite( previousPersistentArea ) &&
+				previousPersistentArea >= 0.0 &&
+				previousPersistentArea <= 1.0;
+			for ( std::size_t i = 0; validHistory && i < sampleCount; i++ )
+				validHistory =
+					std::isfinite( previousConfidence[i] ) &&
+					previousConfidence[i] >= 0.0 &&
+					previousConfidence[i] <= 1.0;
+		}
