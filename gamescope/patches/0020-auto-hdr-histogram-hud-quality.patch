-		};
+		SceneStats result;
+		result.mean = mean;
+		result.upperOccupancy = upperOccupancy;
+		result.approximatePeak = approximatePeak;
+		result.broadFieldLoad = broadFieldLoad;
+		result.validCoverage = validCoverage;
+		uint64_t histogramTotal = 0;
+		for ( uint64_t weight : weightedHistogram )
+			histogramTotal += weight;
+		if ( histogramTotal == 0 )
+			return result;
+		for ( std::size_t i = 0; i < result.histogram.size(); i++ )
+			result.histogram[i] =
+				double( weightedHistogram[i] ) / double( histogramTotal );
+		result.q50 = histogramQuantile(
+			weightedHistogram,
+			histogramTotal,
+			GAMESCOPE_AUTO_HDR_QUANTILE_50_NUMERATOR,
+			GAMESCOPE_AUTO_HDR_QUANTILE_50_DENOMINATOR );
+		result.q90 = histogramQuantile(
+			weightedHistogram,
+			histogramTotal,
+			GAMESCOPE_AUTO_HDR_QUANTILE_90_NUMERATOR,
+			GAMESCOPE_AUTO_HDR_QUANTILE_90_DENOMINATOR );
+		result.q99 = histogramQuantile(
+			weightedHistogram,
+			histogramTotal,
+			GAMESCOPE_AUTO_HDR_QUANTILE_99_NUMERATOR,
+			GAMESCOPE_AUTO_HDR_QUANTILE_99_DENOMINATOR );
+		result.q999 = histogramQuantile(
+			weightedHistogram,
+			histogramTotal,
+			GAMESCOPE_AUTO_HDR_QUANTILE_999_NUMERATOR,
+			GAMESCOPE_AUTO_HDR_QUANTILE_999_DENOMINATOR );
+		result.robustPeak = result.q99 + peakConfidence *
+			( result.q999 - result.q99 );
+		return result;
