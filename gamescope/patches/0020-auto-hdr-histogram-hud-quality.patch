+	bool validNormalizedHistogram(
+		const std::array<double, GAMESCOPE_AUTO_HDR_HISTOGRAM_BINS> &histogram )
+	{
+		double sum = 0.0;
+		for ( double bin : histogram )
+		{
+			if ( !std::isfinite( bin ) || bin < 0.0 || bin > 1.0 )
+				return false;
+			sum += bin;
+		}
+		return std::isfinite( sum ) &&
+			std::abs( sum - 1.0 ) <=
+				GAMESCOPE_AUTO_HDR_HISTOGRAM_SUM_TOLERANCE;
+	}
+
+	double histogramQuantile(
+		const std::array<uint64_t, GAMESCOPE_AUTO_HDR_HISTOGRAM_BINS> &histogram,
+		uint64_t total,
+		uint32_t numerator,
+		uint32_t denominator )
+	{
+		if ( total == 0 || denominator == 0 || numerator > denominator )
+			return 0.0;
+
+		uint64_t verifiedTotal = 0;
+		for ( uint64_t count : histogram )
+			verifiedTotal += count;
+		if ( verifiedTotal != total )
+			return 0.0;
+
+		// Use the exact same rational threshold as the GPU implementation.
+		// Splitting the multiplication around the quotient keeps the calculation
+		// within the histogram total and avoids relying on floating-point
+		// behavior at exact percentile boundaries.
+		const uint64_t quotient = total / denominator;
+		const uint64_t remainder = total % denominator;
+		const uint64_t required =
+			quotient * numerator +
+			( remainder * numerator + denominator - 1u ) / denominator;
+		uint64_t cumulative = 0;
+		for ( std::size_t i = 0; i < histogram.size(); i++ )
+		{
+			cumulative += histogram[i];
+			if ( cumulative >= required )
+				return ( double( i ) + 0.5 ) /
+					double( GAMESCOPE_AUTO_HDR_HISTOGRAM_BINS );
+		}
+		return 1.0 -
+			0.5 / double( GAMESCOPE_AUTO_HDR_HISTOGRAM_BINS );
+	}
+
+	double histogramDistributionDistance(
+		const std::array<double, GAMESCOPE_AUTO_HDR_HISTOGRAM_BINS> &current,
+		const std::array<double, GAMESCOPE_AUTO_HDR_HISTOGRAM_BINS> &previous )
+	{
+		if ( !validNormalizedHistogram( current ) ||
+			!validNormalizedHistogram( previous ) )
+			return 0.0;
+
+		// Use normalized one-dimensional earth-mover distance rather than
+		// per-bin total variation. A small luminance change that crosses one
+		// hard histogram boundary is therefore a one-bin movement, not a full
+		// scene cut. Moving all mass between the darkest and brightest bins
+		// still produces the exact upper bound of one.
+		double distance = 0.0;
+		double currentCumulative = 0.0;
+		double previousCumulative = 0.0;
+		for ( std::size_t i = 0; i + 1 < current.size(); i++ )
+		{
+			currentCumulative += current[i];
+			previousCumulative += previous[i];
+			distance += std::abs( currentCumulative - previousCumulative );
+		}
+		return std::clamp(
+			distance / double( GAMESCOPE_AUTO_HDR_HISTOGRAM_BINS - 1u ),
+			0.0,
+			1.0 );
 	}
 
