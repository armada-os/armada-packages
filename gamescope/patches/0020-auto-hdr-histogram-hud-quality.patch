+	bool validPersistentHUDCell( const PersistentHUDCell &cell )
+	{
+		return std::isfinite( cell.luminance ) &&
+			cell.luminance >= 0.0 && cell.luminance <= 1.0 &&
+			std::isfinite( cell.confidence ) &&
+			cell.confidence >= 0.0 && cell.confidence <= 1.0 &&
+			std::isfinite( cell.variation ) &&
+			cell.variation >= 0.0 && cell.variation <= 1.0;
+	}
+
+	PersistentHUDCell updatePersistentHUDCell(
+		const PersistentHUDCell &previous,
+		double currentLuminance,
+		double coverage,
+		double elapsedSeconds,
+		bool edgeCell,
+		bool reset )
+	{
+		const double luminance = finiteClamped( currentLuminance, 0.0, 1.0 );
+		const double finiteCoverage = finiteClamped( coverage, 0.0, 1.0 );
+		if ( reset || !validPersistentHUDCell( previous ) ||
+			finiteCoverage <= 0.0 ||
+			elapsedSeconds > GAMESCOPE_AUTO_HDR_MAXIMUM_ELAPSED_SECONDS )
+			return { luminance, 0.0, 0.0 };
+		if ( !std::isfinite( elapsedSeconds ) || elapsedSeconds <= 0.0 )
+			return previous;
+
+		const double delta = std::abs( luminance - previous.luminance );
+		const double variationBlend = std::clamp(
+			elapsedSeconds / GAMESCOPE_AUTO_HDR_HUD_VARIATION_SECONDS,
+			0.0,
+			1.0 );
+		const double variation = std::clamp(
+			previous.variation +
+				variationBlend * ( delta - previous.variation ),
+			0.0,
+			1.0 );
+		const double bright = smoothstep(
+			GAMESCOPE_AUTO_HDR_HUD_LUMINANCE_START,
+			GAMESCOPE_AUTO_HDR_HUD_LUMINANCE_FULL,
+			std::min(
+				luminance + ( edgeCell
+					? GAMESCOPE_AUTO_HDR_HUD_EDGE_BONUS
+					: 0.0 ),
+				1.0 ) );
+		const double stable = 1.0 - smoothstep(
+			GAMESCOPE_AUTO_HDR_HUD_STABILITY_FULL,
+			GAMESCOPE_AUTO_HDR_HUD_STABILITY_END,
+			std::max( delta, variation ) );
+		const double candidate = bright * stable;
+		const double acquire = elapsedSeconds /
+			GAMESCOPE_AUTO_HDR_HUD_ACQUIRE_SECONDS;
+		const double release = elapsedSeconds /
+			GAMESCOPE_AUTO_HDR_HUD_RELEASE_SECONDS;
+		const double confidence = std::clamp(
+			previous.confidence +
+				candidate * acquire -
+				( 1.0 - candidate ) * release,
+			0.0,
+			1.0 );
+		return { luminance, confidence, variation };
+	}
+
+	double persistentHUDBroadAreaGate( double persistentArea )
+	{
+		return 1.0 - smoothstep(
+			GAMESCOPE_AUTO_HDR_HUD_BROAD_AREA_START,
+			GAMESCOPE_AUTO_HDR_HUD_BROAD_AREA_FULL,
+			persistentArea );
+	}
+
+	double persistentHUDDiscount( double confidence, double persistentArea )
+	{
+		if ( !std::isfinite( confidence ) || confidence < 0.0 ||
+			confidence > 1.0 || !std::isfinite( persistentArea ) ||
+			persistentArea < 0.0 || persistentArea > 1.0 )
+			return 0.0;
+		return GAMESCOPE_AUTO_HDR_HUD_MAXIMUM_DISCOUNT *
+			smoothstep(
+				GAMESCOPE_AUTO_HDR_HUD_CONFIDENCE_START,
+				GAMESCOPE_AUTO_HDR_HUD_CONFIDENCE_FULL,
+				confidence ) *
+			persistentHUDBroadAreaGate( persistentArea );
+	}
