 	"  --framerate-limit              Set a simple framerate limit. Used as a divisor of the refresh rate, rounds down eg 60 / 59 -> 60fps, 60 / 25 -> 30fps. Default: 0, disabled.\n"
 	"  --mangoapp                     Launch with the mangoapp (mangohud) performance overlay enabled. You should use this instead of using mangohud on the game or gamescope.\n"
 	"  --adaptive-sync                Enable adaptive sync if available (variable rate refresh)\n"
diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index d8b8e37a..5e332d19 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -10,6 +10,7 @@
 #include <algorithm>
 #include <array>
 #include <bitset>
+#include <cmath>
 #include <thread>
 #include <dlfcn.h>
 #include "vulkan_include.h"
@@ -3773,6 +3774,22 @@ float g_flInternalDisplayBrightnessNits = 500.0f;
 
 float g_flHDRItmSdrNits = 100.f;
 float g_flHDRItmTargetNits = 1000.f;
+float g_flHDRItmContentNits = 0.f;
+
+float get_hdr_itm_content_nits()
+{
+	const float sdrNits =
+		std::isfinite( g_flHDRItmSdrNits ) && g_flHDRItmSdrNits > 0.f
+			? g_flHDRItmSdrNits
+			: 100.f;
+	const float targetNits =
+		std::isfinite( g_flHDRItmTargetNits ) && g_flHDRItmTargetNits >= sdrNits
+			? std::min( g_flHDRItmTargetNits, 10000.f )
+			: sdrNits;
+	if ( !std::isfinite( g_flHDRItmContentNits ) || g_flHDRItmContentNits <= 0.f )
+		return targetNits;
+	return std::clamp( g_flHDRItmContentNits, sdrNits, targetNits );
+}
 
 #pragma pack(push, 1)
 struct BlitPushData_t
@@ -3793,6 +3810,7 @@ struct BlitPushData_t
     float u_nitsToLinear; // unset
     float u_itmSdrNits; // unset
     float u_itmTargetNits; // unset
+    float u_itmContentNits; // unset
 
 	explicit BlitPushData_t(const struct FrameInfo_t *frameInfo)
 	{
@@ -3835,6 +3853,7 @@ struct BlitPushData_t
 		u_nitsToLinear = 1.0f / g_flInternalDisplayBrightnessNits;
 		u_itmSdrNits = g_flHDRItmSdrNits;
 		u_itmTargetNits = g_flHDRItmTargetNits;
+		u_itmContentNits = get_hdr_itm_content_nits();
 	}
 
 	explicit BlitPushData_t(float blit_scale) {
@@ -3862,6 +3881,7 @@ struct BlitPushData_t
 		u_nitsToLinear = 1.0f / g_flInternalDisplayBrightnessNits;
 		u_itmSdrNits = g_flHDRItmSdrNits;
 		u_itmTargetNits = g_flHDRItmTargetNits;
+		u_itmContentNits = get_hdr_itm_content_nits();
 	}
 };
 
@@ -3935,6 +3955,7 @@ struct RcasPushData_t
     float u_nitsToLinear; // unset
     float u_itmSdrNits; // unset
     float u_itmTargetNits; // unset
+    float u_itmContentNits; // unset
 
 	RcasPushData_t(const struct FrameInfo_t *frameInfo, float sharpness)
 	{
@@ -3981,6 +4002,7 @@ struct RcasPushData_t
 		u_nitsToLinear = 1.0f / g_flInternalDisplayBrightnessNits;
 		u_itmSdrNits = g_flHDRItmSdrNits;
 		u_itmTargetNits = g_flHDRItmTargetNits;
+		u_itmContentNits = get_hdr_itm_content_nits();
 
 		for (uint32_t i = 1; i < k_nMaxLayers; i++)
 		{
@@ -3995,10 +4017,18 @@ static_assert( offsetof( BlitPushData_t, autoHDRSourceTo2020 ) ==
 	offsetof( BlitPushData_t, ctm ) + sizeof( BlitPushData_t::ctm ) );
 static_assert( offsetof( BlitPushData_t, borderMask ) ==
 	offsetof( BlitPushData_t, autoHDRSourceTo2020 ) + sizeof( glm::mat3x4 ) );
+static_assert( offsetof( BlitPushData_t, u_itmContentNits ) ==
+	offsetof( BlitPushData_t, u_itmTargetNits ) + sizeof( float ) );
+static_assert( sizeof( BlitPushData_t ) ==
+	offsetof( BlitPushData_t, u_itmContentNits ) + sizeof( float ) );
 static_assert( offsetof( RcasPushData_t, autoHDRSourceTo2020 ) ==
 	offsetof( RcasPushData_t, ctm ) + sizeof( RcasPushData_t::ctm ) );
 static_assert( offsetof( RcasPushData_t, u_borderMask ) ==
 	offsetof( RcasPushData_t, autoHDRSourceTo2020 ) + sizeof( glm::mat3x4 ) );
+static_assert( offsetof( RcasPushData_t, u_itmContentNits ) ==
+	offsetof( RcasPushData_t, u_itmTargetNits ) + sizeof( float ) );
+static_assert( sizeof( RcasPushData_t ) ==
+	offsetof( RcasPushData_t, u_itmContentNits ) + sizeof( float ) );
 
 struct NisPushData_t
 {
