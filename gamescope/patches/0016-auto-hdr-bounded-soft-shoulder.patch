diff --git a/src/shaders/colorimetry.h b/src/shaders/colorimetry.h
index a57e64a8..7fd59b79 100644
--- a/src/shaders/colorimetry.h
+++ b/src/shaders/colorimetry.h
@@ -186,37 +186,63 @@ bool finite_color(vec3 color)
     return !any(isnan(color)) && !any(isinf(color));
 }
 
-// Independently derived selective-highlight proof. Preserve the SDR
-// display-light baseline through 85% BT.2020 luminance, then add the available
-// HDR headroom with a C2 quintic smoothstep.
+// Independently derived slope-limited selective-highlight curve. A
+// five-percent derivative ramp makes both joins C2 while bounding the output
+// slope to ten times the SDR reference. The converted-content ceiling remains
+// separate from the output-profile safety peak.
 vec3 efficient_inverse_tonemapping(
     vec3  color,
     float sdr_nits,
-    float target_nits)
+    float target_nits,
+    float content_nits)
 {
     const vec3 k_bt2020 = vec3(0.262698338956556, 0.678008765772817, 0.0592928952706273);
+    const float derivative_ramp_width = 0.05f;
+    const float maximum_slope_multiplier = 10.0f;
 
     if (isnan(sdr_nits) || isinf(sdr_nits) ||
         isnan(target_nits) || isinf(target_nits) ||
-        sdr_nits <= 0.0f || target_nits < sdr_nits || target_nits > 10000.0f)
+        isnan(content_nits) || isinf(content_nits) ||
+        sdr_nits <= 0.0f || target_nits < sdr_nits || target_nits > 10000.0f ||
+        content_nits < sdr_nits || content_nits > target_nits)
         return vec3(0.0f);
 
     color = bounded_color(color, 1.0f);
     if (all(equal(color, vec3(0.0f))))
         return vec3(0.0f);
 
-    const float highlight_knee = 0.85f;
     const float luminance = dot(color, k_bt2020);
     if (luminance <= 0.0f || isnan(luminance) || isinf(luminance))
         return vec3(0.0f);
 
     float mapped_luminance = sdr_nits * luminance;
-    if (luminance > highlight_knee)
+    const float requested_headroom = content_nits - sdr_nits;
+    if (requested_headroom > 0.0f)
     {
-        const float t = clamp(
-            (luminance - highlight_knee) / (1.0f - highlight_knee), 0.0f, 1.0f);
-        const float highlight = t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f);
-        mapped_luminance += (target_nits - sdr_nits) * highlight;
+        const float maximum_added_slope =
+            (maximum_slope_multiplier - 1.0f) * sdr_nits;
+        const float added_slope = min(
+            maximum_added_slope, 2.0f * requested_headroom / derivative_ramp_width);
+        const float maximum_headroom =
+            added_slope * (1.0f - derivative_ramp_width / 2.0f);
+        const float headroom = min(requested_headroom, maximum_headroom);
+        const float shoulder_start =
+            1.0f - headroom / added_slope - derivative_ramp_width / 2.0f;
+        const float u = luminance - shoulder_start;
+
+        if (u > 0.0f && u < derivative_ramp_width)
+        {
+            const float z = u / derivative_ramp_width;
+            const float z2 = z * z;
+            const float z4 = z2 * z2;
+            const float ramp_integral = z4 * (z2 - 3.0f * z + 2.5f);
+            mapped_luminance += added_slope * derivative_ramp_width * ramp_integral;
+        }
+        else if (u >= derivative_ramp_width)
+        {
+            mapped_luminance +=
+                added_slope * (u - derivative_ramp_width / 2.0f);
+        }
     }
 
     vec3 mapped = color * (mapped_luminance / luminance);
