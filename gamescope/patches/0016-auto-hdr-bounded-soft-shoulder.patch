From 505730d365342c067086e470c7a77d2da3dde75b Mon Sep 17 00:00:00 2001
From: enjihn <150061999+enjihn@users.noreply.github.com>
Date: Thu, 23 Jul 2026 00:18:18 -0400
Subject: [PATCH] tune(auto-hdr): bound highlight response

---
 src/AutoHDRColor.cpp                         |  50 ++++-
 src/AutoHDRColor.h                           |   3 +
 src/main.cpp                                 |   3 +
 src/rendervulkan.cpp                         |  30 +++
 src/shaders/blit_push_data.h                 |   1 +
 src/shaders/colorimetry.h                    |  48 ++++-
 src/shaders/composite.h                      |   3 +-
 src/shaders/cs_composite_rcas.comp           |   1 +
 src/shaders/cs_gaussian_blur_horizontal.comp |   1 +
 src/shaders/cs_rgb_to_nv12.comp              |   1 +
 src/steamcompmgr.cpp                         |  12 +-
 tests/test_auto_hdr_color.cpp                | 206 ++++++++++++++++---
 12 files changed, 305 insertions(+), 54 deletions(-)

diff --git a/src/AutoHDRColor.cpp b/src/AutoHDRColor.cpp
index 6387c018..bd01d74a 100644
--- a/src/AutoHDRColor.cpp
+++ b/src/AutoHDRColor.cpp
@@ -13,6 +13,8 @@ namespace gamescope::autohdr
 		constexpr double kBT2020R = 0.262698338956556;
 		constexpr double kBT2020G = 0.678008765772817;
 		constexpr double kBT2020B = 0.0592928952706273;
+		constexpr double kDerivativeRampWidth = 0.05;
+		constexpr double kMaximumSlopeMultiplier = 10.0;
 		double finiteNonNegative( double value )
 		{
 			return std::isfinite( value ) ? std::max( value, 0.0 ) : 0.0;
@@ -36,6 +38,11 @@ namespace gamescope::autohdr
 		{
 			return std::isfinite( value.r ) && std::isfinite( value.g ) && std::isfinite( value.b );
 		}
+
+		double effectiveContentNits( const Config &config )
+		{
+			return config.contentNits.value_or( config.targetNits );
+		}
 	}
 
 	bool validConfig( const Config &config )
@@ -44,7 +51,11 @@ namespace gamescope::autohdr
 			std::isfinite( config.targetNits ) &&
 			config.sdrNits > 0.0 &&
 			config.targetNits >= config.sdrNits &&
-			config.targetNits <= 10000.0;
+			config.targetNits <= 10000.0 &&
+			( !config.contentNits ||
+				( std::isfinite( *config.contentNits ) &&
+					*config.contentNits >= config.sdrNits &&
+					*config.contentNits <= config.targetNits ) );
 	}
 
 	double srgbDecode( double encoded )
@@ -120,9 +131,10 @@ namespace gamescope::autohdr
 
 	std::optional<RGB> efficientInverseToneMap( const RGB &linearRec2020, const Config &config )
 	{
-		// Independently derived selective-highlight proof. Preserve the SDR
-		// display-light baseline through 85% BT.2020 luminance, then add the
-		// available HDR headroom with a C2 quintic smoothstep.
+		// Independently derived slope-limited selective-highlight curve. A
+		// five-percent derivative ramp makes both joins C2 while bounding the
+		// output slope to ten times the SDR reference. The converted-content
+		// ceiling remains separate from the output-profile safety peak.
 		if ( !validConfig( config ) )
 			return std::nullopt;
 
@@ -130,18 +142,36 @@ namespace gamescope::autohdr
 		if ( color.r == 0.0 && color.g == 0.0 && color.b == 0.0 )
 			return RGB{};
 
-		constexpr double highlightKnee = 0.85;
 		const double luminance = kBT2020R * color.r + kBT2020G * color.g + kBT2020B * color.b;
 		if ( luminance <= 0.0 || !std::isfinite( luminance ) )
 			return RGB{};
 
 		double mappedLuminance = config.sdrNits * luminance;
-		if ( luminance > highlightKnee )
+		const double requestedHeadroom = effectiveContentNits( config ) - config.sdrNits;
+		if ( requestedHeadroom > 0.0 )
 		{
-			const double t = std::clamp(
-				( luminance - highlightKnee ) / ( 1.0 - highlightKnee ), 0.0, 1.0 );
-			const double highlight = t * t * t * ( t * ( t * 6.0 - 15.0 ) + 10.0 );
-			mappedLuminance += ( config.targetNits - config.sdrNits ) * highlight;
+			const double maximumAddedSlope = ( kMaximumSlopeMultiplier - 1.0 ) * config.sdrNits;
+			const double addedSlope = std::min(
+				maximumAddedSlope, 2.0 * requestedHeadroom / kDerivativeRampWidth );
+			const double maximumHeadroom =
+				addedSlope * ( 1.0 - kDerivativeRampWidth / 2.0 );
+			const double headroom = std::min( requestedHeadroom, maximumHeadroom );
+			const double shoulderStart =
+				1.0 - headroom / addedSlope - kDerivativeRampWidth / 2.0;
+			const double u = luminance - shoulderStart;
+
+			if ( u > 0.0 && u < kDerivativeRampWidth )
+			{
+				const double z = u / kDerivativeRampWidth;
+				const double z2 = z * z;
+				const double z4 = z2 * z2;
+				const double rampIntegral = z4 * ( z2 - 3.0 * z + 2.5 );
+				mappedLuminance += addedSlope * kDerivativeRampWidth * rampIntegral;
+			}
+			else if ( u >= kDerivativeRampWidth )
+			{
+				mappedLuminance += addedSlope * ( u - kDerivativeRampWidth / 2.0 );
+			}
 		}
 
 		const double scale = mappedLuminance / luminance;
diff --git a/src/AutoHDRColor.h b/src/AutoHDRColor.h
index 9ce03ba3..556020ac 100644
--- a/src/AutoHDRColor.h
+++ b/src/AutoHDRColor.h
@@ -36,6 +36,9 @@ namespace gamescope::autohdr
 	{
 		double sdrNits;
 		double targetNits;
+		// Converted SDR content may use less than the output-profile safety peak.
+		// An unset ceiling preserves the existing target-based configuration.
+		std::optional<double> contentNits = std::nullopt;
 	};
 
 	bool validConfig( const Config &config );
