+const float u_itmContentNits = u_itmTargetNits;
 const mat3x4 u_autoHDRSourceTo2020 = mat3x4(1.0f);
 
 layout(binding = 0, scalar)
diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index ac2c0712..f143adf7 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -168,6 +168,8 @@ bool g_bForceHDRSupportDebug = false;
 extern float g_flInternalDisplayBrightnessNits;
 extern float g_flHDRItmSdrNits;
 extern float g_flHDRItmTargetNits;
+extern float g_flHDRItmContentNits;
+extern float get_hdr_itm_content_nits();
 
 uint64_t g_lastWinSeq = 0;
 
@@ -2617,10 +2619,13 @@ static void update_auto_hdr_policy( FrameInfo_t *frameInfo, gamescope::IBackendC
 	static uint64_t previousConnectorID = 0;
 	static uint64_t previousSdrBits = 0;
 	static uint64_t previousTargetBits = 0;
+	static uint64_t previousContentBits = 0;
 	static uint64_t previousPeakBits = 0;
 	const uint64_t connectorID = connector ? connector->GetConnectorID() : 0;
 	const uint64_t sdrBits = std::bit_cast<uint64_t>( input.sdrReferenceNits );
 	const uint64_t targetBits = std::bit_cast<uint64_t>( input.targetNits );
+	const float contentNits = get_hdr_itm_content_nits();
+	const uint64_t contentBits = std::bit_cast<uint64_t>( double( contentNits ) );
 	const uint64_t peakBits = std::bit_cast<uint64_t>( input.calibratedOutputPeakNits );
 	if ( !logged ||
 		 previous.layerMask != result.layerMask ||
@@ -2628,21 +2633,24 @@ static void update_auto_hdr_policy( FrameInfo_t *frameInfo, gamescope::IBackendC
 		 previousConnectorID != connectorID ||
 		 previousSdrBits != sdrBits ||
 		 previousTargetBits != targetBits ||
+		 previousContentBits != contentBits ||
 		 previousPeakBits != peakBits )
 	{
-		auto_hdr_log.infof( "connector=%s id=%" PRIu64 " policy=%.*s layer-mask=0x%08x sdr=%.1f target=%.1f peak=%.1f nits",
+		auto_hdr_log.infof( "connector=%s id=%" PRIu64 " policy=%.*s layer-mask=0x%08x sdr=%.1f content=%.1f target=%.1f peak=%.1f nits",
 			connector ? connector->GetName() : "none",
 			connectorID,
 			int( gamescope::autohdr::policyReasonName( result.reason ).size() ),
 			gamescope::autohdr::policyReasonName( result.reason ).data(),
 			result.layerMask,
 			input.sdrReferenceNits,
+			contentNits,
 			input.targetNits,
 			input.calibratedOutputPeakNits );
 		previous = result;
 		previousConnectorID = connectorID;
 		previousSdrBits = sdrBits;
 		previousTargetBits = targetBits;
+		previousContentBits = contentBits;
 		previousPeakBits = peakBits;
 		logged = true;
 	}
@@ -8552,6 +8560,8 @@ steamcompmgr_main(int argc, char **argv)
 					g_flHDRItmSdrNits = atof(optarg);
 				} else if (strcmp(opt_name, "hdr-itm-target-nits") == 0) {
 					g_flHDRItmTargetNits = atof(optarg);
+				} else if (strcmp(opt_name, "hdr-itm-content-nits") == 0) {
+					g_flHDRItmContentNits = atof(optarg);
 				} else if (strcmp(opt_name, "framerate-limit") == 0) {
 					g_nSteamCompMgrTargetFPS = atoi(optarg);
 				} else if (strcmp(opt_name, "reshade-effect") == 0) {
diff --git a/tests/test_auto_hdr_color.cpp b/tests/test_auto_hdr_color.cpp
index e7e9d9cf..e4693597 100644
--- a/tests/test_auto_hdr_color.cpp
+++ b/tests/test_auto_hdr_color.cpp
@@ -46,6 +46,66 @@ namespace
 		const auto mapped = gamescope::autohdr::efficientInverseToneMap( { level, level, level }, config );
 		return mapped ? mapped->r : std::numeric_limits<double>::quiet_NaN();
 	}
+
+	double bt2020Luminance( const RGB &value )
+	{
+		return 0.262698338956556 * value.r +
+			0.678008765772817 * value.g +
+			0.0592928952706273 * value.b;
+	}
+
+	struct CurveParameters
+	{
+		double contentNits;
+		double addedSlope;
+		double headroom;
+		double shoulderStart;
+	};
+
+	CurveParameters curveParameters( const Config &config )
+	{
+		constexpr double rampWidth = 0.05;
+		const double contentNits = config.contentNits.value_or( config.targetNits );
+		const double requestedHeadroom = contentNits - config.sdrNits;
+		if ( requestedHeadroom <= 0.0 )
+			return { contentNits, 0.0, 0.0, 1.0 };
+		const double addedSlope = std::min( 9.0 * config.sdrNits, 2.0 * requestedHeadroom / rampWidth );
+		const double headroom = std::min(
+			requestedHeadroom, addedSlope * ( 1.0 - rampWidth / 2.0 ) );
+		return {
+			contentNits,
