index 0000000000000000000000000000000000000000..cae8d72b6fb268d61c8174e6478d581d44154aec
--- /dev/null
+++ b/tests/test_auto_hdr_gamut.cpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+#include "color_helpers.h"
+
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+#include <string_view>
+
+namespace
+{
+	int failures = 0;
+
+	void check( bool condition, std::string_view message )
+	{
+		if ( condition )
+			return;
+		std::cerr << "FAIL: " << message << '\n';
+		failures++;
+	}
+
+	void near( float actual, float expected, float tolerance, std::string_view message )
+	{
+		check( std::isfinite( actual ) && std::abs( actual - expected ) <= tolerance, message );
+	}
+
+	void near( const glm::vec2 &actual, const glm::vec2 &expected, float tolerance, std::string_view message )
+	{
+		near( actual.x, expected.x, tolerance, message );
+		near( actual.y, expected.y, tolerance, message );
+	}
+
+	void near( const glm::vec3 &actual, const glm::vec3 &expected, float tolerance, std::string_view message )
+	{
+		near( actual.x, expected.x, tolerance, message );
+		near( actual.y, expected.y, tolerance, message );
+		near( actual.z, expected.z, tolerance, message );
+	}
+
+	void checkColorimetry( const displaycolorimetry_t &actual, const displaycolorimetry_t &expected,
+		std::string_view message )
+	{
+		near( actual.primaries.r, expected.primaries.r, 1e-6f, message );
+		near( actual.primaries.g, expected.primaries.g, 1e-6f, message );
+		near( actual.primaries.b, expected.primaries.b, 1e-6f, message );
+		near( actual.white, expected.white, 1e-6f, message );
+	}
+
+	glm::mat3 rgbToXYZ( const displaycolorimetry_t &colorimetry )
+	{
+		auto xyToXYZ = []( const glm::vec2 &xy )
+		{
+			return glm::vec3( xy.x / xy.y, 1.f, ( 1.f - xy.x - xy.y ) / xy.y );
+		};
+		const glm::mat3 primaries(
+			xyToXYZ( colorimetry.primaries.r ),
+			xyToXYZ( colorimetry.primaries.g ),
+			xyToXYZ( colorimetry.primaries.b ) );
+		const glm::vec3 scale = glm::inverse( primaries ) * xyToXYZ( colorimetry.white );
+		return primaries * glm::mat3(
+			scale.x, 0.f, 0.f,
+			0.f, scale.y, 0.f,
+			0.f, 0.f, scale.z );
+	}
+
+	void checkSourceContinuity( const displaycolorimetry_t &source, const glm::vec3 &linearSource,
+		std::string_view message )
+	{
+		const glm::mat3 sourceTo2020 = colorimetryConversionMatrix( source, displaycolorimetry_2020 );
+		const glm::vec3 sourceXYZ = rgbToXYZ( source ) * linearSource;
+		const glm::vec3 convertedXYZ = k_xyz_from_2020 * ( sourceTo2020 * linearSource );
+		near( convertedXYZ, sourceXYZ, 2e-6f, message );
+	}
+}
+
+int main()
+{
+	// The live Odin 3 profile is native P3-like. Default wideness must therefore
+	// preserve the source colors the normal SDR-on-HDR LUT interprets as native.
+	const displaycolorimetry_t odinNativeP3
+	{
+		.primaries = {
+			{ 0.6800f, 0.3200f },
+			{ 0.2650f, 0.6900f },
+			{ 0.1500f, 0.0600f },
+		},
+		.white = { 0.3127f, 0.3290f },
+	};
+	const displaycolorimetry_t odinEffective = effectiveSDRColorimetry( -1.f, odinNativeP3 );
+	checkColorimetry( odinEffective, odinNativeP3, "Odin default SDR source remains native P3" );
+	checkSourceContinuity( odinEffective, { 0.82f, 0.24f, 0.07f },
+		"Odin native-P3 source is continuous through BT.2020 conversion" );
+
+	// A Rec.709-native output keeps the historical Rec.709 default and matrix.
+	const displaycolorimetry_t rec709Effective = effectiveSDRColorimetry( -1.f, displaycolorimetry_709 );
+	checkColorimetry( rec709Effective, displaycolorimetry_709, "Rec.709 default SDR source remains Rec.709" );
+	const glm::mat3 default709To2020 = colorimetryConversionMatrix( rec709Effective, displaycolorimetry_2020 );
+	for ( int column = 0; column < 3; column++ )
+		near( default709To2020[column], k_2020_from_709[column], 1e-6f,
+			"Rec.709 default uses canonical BT.2020 conversion" );
+	checkSourceContinuity( rec709Effective, { 0.11f, 0.53f, 0.91f },
+		"Rec.709 source is continuous through BT.2020 conversion" );
+
+	if ( failures != 0 )
+	{
+		std::cerr << failures << " Auto HDR gamut continuity test(s) failed\n";
+		return EXIT_FAILURE;
+	}
+
+	std::cout << "Auto HDR gamut continuity tests passed\n";
+	return EXIT_SUCCESS;
+}
