+static gamescope::autohdr::AnalysisReconstruction
+auto_hdr_analysis_reconstruction( const FrameInfo_t::Layer_t &source )
+{
+	const gamescope::autohdr::AnalysisSourceEncoding encoding =
+		source.colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR
+			? gamescope::autohdr::AnalysisSourceEncoding::Linear
+			: source.colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB
+				? gamescope::autohdr::AnalysisSourceEncoding::SRGB
+				: gamescope::autohdr::AnalysisSourceEncoding::Unsupported;
+	gamescope::autohdr::AnalysisFilter filter =
+		gamescope::autohdr::AnalysisFilter::Unknown;
+	switch ( source.filter )
+	{
+		case GamescopeUpscaleFilter::LINEAR:
+			filter = gamescope::autohdr::AnalysisFilter::Linear;
+			break;
+		case GamescopeUpscaleFilter::NEAREST:
+			filter = gamescope::autohdr::AnalysisFilter::Nearest;
+			break;
+		case GamescopeUpscaleFilter::FSR:
+			filter = gamescope::autohdr::AnalysisFilter::FSR;
+			break;
+		case GamescopeUpscaleFilter::NIS:
+			filter = gamescope::autohdr::AnalysisFilter::NIS;
+			break;
+		case GamescopeUpscaleFilter::PIXEL:
+			filter = gamescope::autohdr::AnalysisFilter::Pixel;
+			break;
+		default:
+			break;
+	}
+
+	return gamescope::autohdr::analysisReconstruction(
+		encoding, filter, source.isScreenSize(), source.isYcbcr() );
+}
