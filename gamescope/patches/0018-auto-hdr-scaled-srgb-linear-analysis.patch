+    vec4 green = textureGather(s_samplers[0], gather_uv, 1);
+    vec4 blue = textureGather(s_samplers[0], gather_uv, 2);
+    vec4 alpha = textureGather(s_samplers[0], gather_uv, 3);
+
+    vec4 c00 = vec4(red.w, green.w, blue.w, alpha.w);
+    vec4 c01 = vec4(red.x, green.x, blue.x, alpha.x);
+    vec4 c11 = vec4(red.y, green.y, blue.y, alpha.y);
+    vec4 c10 = vec4(red.z, green.z, blue.z, alpha.z);
+    c00.rgb = decode_source(c00.rgb);
+    c01.rgb = decode_source(c01.rgb);
+    c11.rgb = decode_source(c11.rgb);
+    c10.rgb = decode_source(c10.rgb);
+
+    vec2 weight = pixel_coord - origin;
+    vec4 lower = mix(c00, c10, weight.x);
+    vec4 upper = mix(c01, c11, weight.x);
+    return mix(lower, upper, weight.y);
+}
