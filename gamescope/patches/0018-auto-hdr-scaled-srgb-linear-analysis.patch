+	AnalysisReconstruction analysisReconstruction(
+		AnalysisSourceEncoding encoding,
+		AnalysisFilter filter,
+		bool screenSize,
+		bool ycbcr )
+	{
+		if ( ycbcr || encoding == AnalysisSourceEncoding::Unsupported )
+			return AnalysisReconstruction::Unsupported;
+
+		if ( screenSize || filter == AnalysisFilter::Nearest )
+			return AnalysisReconstruction::Regular;
+
+		if ( filter != AnalysisFilter::Linear )
+			return AnalysisReconstruction::Unsupported;
+
+		return encoding == AnalysisSourceEncoding::SRGB
+			? AnalysisReconstruction::ManualSRGBBilinear
+			: AnalysisReconstruction::Regular;
+	}
+
+	AnalysisPoint analysisSourceCoordinate(
+		uint32_t gridX,
+		uint32_t gridY,
+		const AnalysisGrid &grid,
+		uint32_t displayWidth,
+		uint32_t displayHeight,
+		const AnalysisPoint &scale,
+		const AnalysisPoint &offset )
+	{
+		if ( grid.width == 0 || grid.height == 0 )
+			return {};
+
+		const AnalysisPoint displayCoordinate = {
+			( double( gridX ) + 0.5 ) / double( grid.width ) *
+				double( displayWidth ),
+			( double( gridY ) + 0.5 ) / double( grid.height ) *
+				double( displayHeight ),
+		};
+		return {
+			( displayCoordinate.x - 0.5 + offset.x ) * scale.x,
+			( displayCoordinate.y - 0.5 + offset.y ) * scale.y,
+		};
+	}
+
+	AnalysisRGBA reconstructSRGBBilinear2x2(
+		const AnalysisRGBA *texels,
+		const AnalysisPoint &sourceCoordinate )
+	{
+		if ( !texels )
+			return {};
+
+		const double pixelX = sourceCoordinate.x - 0.5;
+		const double pixelY = sourceCoordinate.y - 0.5;
+		const int originX = int( std::floor( pixelX ) );
+		const int originY = int( std::floor( pixelY ) );
+		const double weightX = pixelX - double( originX );
+		const double weightY = pixelY - double( originY );
+		const auto fetch = [&]( int x, int y )
+		{
+			x = std::clamp( x, 0, 1 );
+			y = std::clamp( y, 0, 1 );
+			AnalysisRGBA value = texels[y * 2 + x];
+			const auto decode = []( double encoded )
+			{
+				return encoded <= 0.04045
+					? encoded / 12.92
+					: std::pow( ( encoded + 0.055 ) / 1.055, 2.4 );
+			};
+			value.r = decode( value.r );
+			value.g = decode( value.g );
+			value.b = decode( value.b );
+			return value;
+		};
+		const auto mix = []( const AnalysisRGBA &a, const AnalysisRGBA &b, double weight )
+		{
+			return AnalysisRGBA{
+				a.r + weight * ( b.r - a.r ),
+				a.g + weight * ( b.g - a.g ),
+				a.b + weight * ( b.b - a.b ),
+				a.a + weight * ( b.a - a.a ),
+			};
+		};
+
+		const AnalysisRGBA c00 = fetch( originX, originY );
+		const AnalysisRGBA c10 = fetch( originX + 1, originY );
+		const AnalysisRGBA c01 = fetch( originX, originY + 1 );
+		const AnalysisRGBA c11 = fetch( originX + 1, originY + 1 );
+		return mix(
+			mix( c00, c10, weightX ),
+			mix( c01, c11, weightX ),
+			weightY );
+	}
