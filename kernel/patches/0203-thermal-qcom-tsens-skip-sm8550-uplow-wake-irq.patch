From 2b4adfaf66434bddbde753c3ae7229d8c73a0ea5 Mon Sep 17 00:00:00 2001
From: jaewun <jaewun@users.noreply.github.com>
Date: Mon, 11 May 2026 01:20:00 +1200
Subject: [PATCH] thermal: qcom: tsens: skip SM8550 uplow wake IRQs

Native s2idle testing on SM8550 devices repeatedly resumes immediately with
pm_wakeup_irq pointing at the SM8550 TSENS uplow/passive threshold IRQ.
The IRQ wake state exposed under /sys/kernel/irq is read-only on the live
kernel, so runtime testing cannot disable this wake source.

Keep normal TSENS interrupt handling active and keep critical TSENS wake
enabled. Only skip enable_irq_wake() for the ordinary "uplow" TSENS IRQs on
qcom,sm8550. Scoped to the SoC-level compatible (not a specific board) so it
covers every SM8550 board, not just the one it was first observed on.
---
 drivers/thermal/qcom/tsens.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/thermal/qcom/tsens.c b/drivers/thermal/qcom/tsens.c
index fbdab9d00000..fbdab9d00001 100644
--- a/drivers/thermal/qcom/tsens.c
+++ b/drivers/thermal/qcom/tsens.c
@@ -1226,6 +1226,15 @@ static const struct thermal_zone_device_ops tsens_of_ops = {
 	.set_trips = tsens_set_trips,
 };
 
+static bool tsens_irq_wake_enabled(const char *irqname)
+{
+	if (!of_machine_is_compatible("qcom,sm8550"))
+		return true;
+
+	/* Keep critical thermal wake; only passive threshold-window IRQs are noisy. */
+	return strcmp(irqname, "uplow") != 0;
+}
+
 static int tsens_register_irq(struct tsens_priv *priv, char *irqname,
 			      irq_handler_t thread_fn, int *irq_num)
 {
@@ -1297,7 +1306,8 @@ int tsens_suspend_common(struct tsens_priv *priv)
 	if (priv->feat->combo_int)
 		enable_irq_wake(priv->combined_irq);
 	else {
-		enable_irq_wake(priv->uplow_irq);
+		if (tsens_irq_wake_enabled("uplow"))
+			enable_irq_wake(priv->uplow_irq);
 		if (priv->feat->crit_int)
 			enable_irq_wake(priv->crit_irq);
 	}
@@ -1316,7 +1326,8 @@ int tsens_resume_common(struct tsens_priv *priv)
 	if (priv->feat->combo_int)
 		disable_irq_wake(priv->combined_irq);
 	else {
-		disable_irq_wake(priv->uplow_irq);
+		if (tsens_irq_wake_enabled("uplow"))
+			disable_irq_wake(priv->uplow_irq);
 		if (priv->feat->crit_int)
 			disable_irq_wake(priv->crit_irq);
 	}
-- 
