From: ROCKNIX <noreply@rocknix.org>
Subject: [PATCH] pmdomain: qcom: rpmhpd: don't clamp the SM8550 GFX rail pre-sync_state

Give SM8550 a dedicated GFX power-domain descriptor that is treated as
synced from boot, so its pre-sync votes use the real lowest corner. Keep
the shared descriptor unchanged for the other Qualcomm SoCs.

---
diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -122,6 +122,12 @@
 	.res_name = "gfx.lvl",
 };
 
+static struct rpmhpd gfx_sm8550 = {
+	.pd = { .name = "gfx", },
+	.res_name = "gfx.lvl",
+	.state_synced = true,
+};
+
 static struct rpmhpd lcx = {
 	.pd = { .name = "lcx", },
 	.res_name = "lcx.lvl",
@@ -559,7 +565,7 @@
 	[RPMHPD_CX] = &cx,
 	[RPMHPD_CX_AO] = &cx_ao,
 	[RPMHPD_EBI] = &ebi,
-	[RPMHPD_GFX] = &gfx,
+	[RPMHPD_GFX] = &gfx_sm8550,
 	[RPMHPD_LCX] = &lcx,
 	[RPMHPD_LMX] = &lmx,
 	[RPMHPD_MMCX] = &mmcx_w_cx_parent,
