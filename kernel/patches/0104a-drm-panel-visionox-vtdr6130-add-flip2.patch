From 5cf397ae2da2ebae2c2c5528954939e65c853d31 Mon Sep 17 00:00:00 2001
From: Jacob Pyke <github@pyk.ee>
Date: Thu, 27 Aug 2026 21:27:32 +1000
Subject: [PATCH] drm/panel: visionox-vtdr6130-cog: add Flip 2 support

Some Retroid Pocket Flip 2 units use a Visionox VTDR6130 panel
instead of the CH13726A panel currently described by Armada.

The affected unit's Android device tree selects the VTDR6130 COG
command-mode panel and uses the same initialization sequence, display
modes, and DSC configuration as the existing Pocket 6 driver.

Add a compatible for the Flip 2 panel and select the four regulator
supplies exposed by the SM8250 device tree.

Correct the missing F0 byte in the vendor page-selection command to
match the Android initialization sequence.

Signed-off-by: Jacob Pyke <github@pyk.ee>
---
 .../drm/panel/panel-visionox-vtdr6130-cog.c   | 33 ++++++++++++++-----
 1 file changed, 25 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
index 0ebf679..d2469ee 100644
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
@@ -32,6 +32,7 @@ struct panel_info {
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	unsigned int num_supplies;
 };
 
 struct panel_desc {
@@ -58,6 +59,13 @@ static const struct regulator_bulk_data panel_supplies[] = {
 	{ .supply = "vdd28" },
 };
 
+static const struct regulator_bulk_data flip2_panel_supplies[] = {
+	{ .supply = "vdd1v2" },
+	{ .supply = "vddio" },
+	{ .supply = "vdd" },
+	{ .supply = "avdd" },
+};
+
 static inline struct panel_info *to_panel_info(struct drm_panel *panel)
 {
 	return container_of(panel, struct panel_info, panel);
@@ -143,7 +151,7 @@ static int vtdr6130_rp6_init_sequence(struct panel_info *pinfo)
 					0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
 	}
 
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xAA, 0x10);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xF0, 0xAA, 0x10);
 
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB1, 
 				0x02, 0x16, 0x00, 0x14, 0x00, 0x1C, 0x00, 0x02,
@@ -266,7 +274,7 @@ static int vtdr6130_prepare(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	int ret;
 
-    ret = regulator_bulk_enable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+	ret = regulator_bulk_enable(pinfo->num_supplies, pinfo->supplies);
 	if (ret < 0) {
 		dev_err(panel->dev, "failed to enable regulators: %d\n", ret);
 		return ret;
@@ -276,7 +284,7 @@ static int vtdr6130_prepare(struct drm_panel *panel)
 
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
-        regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+		regulator_bulk_disable(pinfo->num_supplies, pinfo->supplies);
 		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
 		return ret;
 	}
@@ -304,7 +312,7 @@ static int vtdr6130_unprepare(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
-    regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+	regulator_bulk_disable(pinfo->num_supplies, pinfo->supplies);
 
 	return 0;
 }
@@ -424,6 +432,7 @@ static struct backlight_device *vtdr6130_create_backlight(struct mipi_dsi_device
 static int vtdr6130_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
+	const struct regulator_bulk_data *supplies;
 	struct panel_info *pinfo;
 	int ret;
 
@@ -433,12 +442,19 @@ static int vtdr6130_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
-	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
-	panel_supplies, &pinfo->supplies);
-	if (ret < 0){
-		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+	if (of_device_is_compatible(dev->of_node,
+				    "visionox,vtdr6130-flip2")) {
+		supplies = flip2_panel_supplies;
+		pinfo->num_supplies = ARRAY_SIZE(flip2_panel_supplies);
+	} else {
+		supplies = panel_supplies;
+		pinfo->num_supplies = ARRAY_SIZE(panel_supplies);
 	}
 
+	ret = devm_regulator_bulk_get_const(dev, pinfo->num_supplies, supplies, &pinfo->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
 	pinfo->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
 	if (IS_ERR(pinfo->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(pinfo->reset_gpio), "failed to get reset gpio\n");
@@ -482,6 +498,7 @@ static int vtdr6130_probe(struct mipi_dsi_device *dsi)
 
 static const struct of_device_id vtdr6130_of_match[] = {
 	{ .compatible = "vtdr6130,rp6", .data = &vtdr6130_rp6_desc },
+	{ .compatible = "visionox,vtdr6130-flip2", .data = &vtdr6130_rp6_desc },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, vtdr6130_of_match);
-- 
2.55.0

