From: gh123man <gh123man@users.noreply.github.com>
Subject: [PATCH] scsi: ufs: recover clock-gating hibern8-enter failures inline

[armada] Ported to 7.1.5: hba->system_suspending does not exist in that
tree's struct ufs_hba. It is used here only to capture diagnostic state for
the failure log, never for control flow, so it is mapped to the nearest
equivalent that does exist, hba->is_sys_suspended. Recovery logic is
unchanged and still keys off pm_op_in_progress and the clk_gating state.

[armada] Restrict inline recovery to the existing SM8550 native-sleep gate.
The normal UFS clock-gating failure path remains unchanged unless sm8550.ns=1
is active on an SM8550 UFS host. This patch is ordered after 1029 so its
ufshcd_sm8550_relink_workaround() helper is available.

ufshcd_gate_work() only restores the software clock-gating state to CLKS_ON
when DME_HIBER_ENTER times out.  It does not repair the UFS link.  This is
especially destructive while system PM is in progress: pm_op_in_progress
intentionally suppresses the generic fatal error handler, so the controller
is left operational in software but unable to complete device commands.
Subsequent filesystem I/O repeatedly times out and a following suspend can
block forever in the filesystem sync, after userspace has already blanked
the display.

Recover a failed clock-gating hibern8 enter inline, matching the recovery
already used for clock-gating hibern8-exit failures by the SM8550 PM relink
patch. Use a dedicated recovery-in-progress flag around the UIC command and
recovery so the generic UIC error path cannot race a second error-handler
reset, without borrowing or overwriting system PM's clk_gating.is_suspended
state. Arm the non-MCQ relink poller while the link is reset so completion does
not depend on the threaded ONESHOT IRQ.

After the first failure, pin runtime UFS clock gating off for the remainder of
the boot.  This is the same active-request pin used by the clkgate_enable
sysfs control.  System PM remains enabled and can still transition the UFS
device and link for suspend, while the failed idle Hibern8 path is not retried.

Capture the clock-gating and PM state when the worker is admitted, immediately
before DME_HIBER_ENTER, and after a failure.  Emit the snapshots only on the
failure path.  This makes it possible to distinguish a controller failure
from a race where system suspend requests clocks back on after the gate worker
has passed its initial eligibility check.

Signed-off-by: gh123man <gh123man@users.noreply.github.com>
---
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -2107,6 +2107,11 @@ static void ufshcd_gate_work(struct work_struct *work)
 {
 	struct ufs_hba *hba = container_of(work, struct ufs_hba,
 			clk_gating.gate_work.work);
+	enum clk_gating_state admitted_state;
+	int admitted_active_reqs;
+	bool admitted_pm;
+	bool admitted_system_suspend;
+	bool recover_inline = ufshcd_sm8550_relink_workaround(hba);
 	int ret;
 
 	scoped_guard(spinlock_irqsave, &hba->clk_gating.lock) {
@@ -2126,6 +2131,18 @@ static void ufshcd_gate_work(struct work_struct *work)
 
 		if (hba->clk_gating.active_reqs)
 			return;
+
+		/*
+		 * Preserve the state that admitted this worker.  A suspend request
+		 * can race after this lock is dropped and change the gating state
+		 * before the Hibern8 command is sent.
+		 */
+		if (recover_inline) {
+			admitted_state = hba->clk_gating.state;
+			admitted_active_reqs = hba->clk_gating.active_reqs;
+			admitted_pm = READ_ONCE(hba->pm_op_in_progress);
+			admitted_system_suspend = READ_ONCE(hba->is_sys_suspended);
+		}
 	}
 
 	scoped_guard(spinlock_irqsave, hba->host->host_lock) {
@@ -2136,16 +2153,108 @@ static void ufshcd_gate_work(struct work_struct *work)
 
 	/* put the link into hibern8 mode before turning off clocks */
 	if (ufshcd_can_hibern8_during_gating(hba)) {
+		enum clk_gating_state h8_start_state;
+		int h8_start_active_reqs;
+		bool h8_start_pm;
+		bool h8_start_system_suspend;
+
+		if (recover_inline) {
+			/* Snapshot any state transition since worker admission. */
+			scoped_guard(spinlock_irqsave, &hba->clk_gating.lock) {
+				h8_start_state = hba->clk_gating.state;
+				h8_start_active_reqs = hba->clk_gating.active_reqs;
+			}
+			h8_start_pm = READ_ONCE(hba->pm_op_in_progress);
+			h8_start_system_suspend = READ_ONCE(hba->is_sys_suspended);
+		}
+
+		/* Exclude the generic fatal handler while this worker owns recovery. */
+		if (recover_inline)
+			WRITE_ONCE(hba->sm8550_gate_recovery_active, true);
 		ret = ufshcd_uic_hibern8_enter(hba);
 		if (ret) {
-			hba->clk_gating.state = CLKS_ON;
-			dev_err(hba->dev, "%s: hibern8 enter failed %d\n",
+			enum clk_gating_state failed_state;
+			int failed_active_reqs;
+			bool failed_enabled;
+			bool failed_suspended;
+
+			if (!recover_inline) {
+				hba->clk_gating.state = CLKS_ON;
+				dev_err(hba->dev, "%s: hibern8 enter failed %d\n",
+					__func__, ret);
+				trace_ufshcd_clk_gating(hba,
+							hba->clk_gating.state);
+				return;
+			}
+
+			scoped_guard(spinlock_irqsave, &hba->clk_gating.lock) {
+				failed_state = hba->clk_gating.state;
+				failed_active_reqs = hba->clk_gating.active_reqs;
+				failed_enabled = hba->clk_gating.is_enabled;
+				failed_suspended = hba->clk_gating.is_suspended;
+				hba->clk_gating.state = CLKS_ON;
+			}
+			dev_err(hba->dev,
+				"%s: hibern8 enter failed %d, recovering link\n",
 					__func__, ret);
+			dev_err(hba->dev,
+				"%s: gate race snapshot: admitted state=%d active=%d pm=%d system=%d; h8-start state=%d active=%d pm=%d system=%d; failed state=%d active=%d enabled=%d suspended=%d pm=%d system=%d outstanding=%#lx gate-work=%u ungate-work=%u\n",
+				__func__, admitted_state, admitted_active_reqs,
+				admitted_pm, admitted_system_suspend,
+				h8_start_state, h8_start_active_reqs,
+				h8_start_pm, h8_start_system_suspend,
+				failed_state, failed_active_reqs,
+				failed_enabled, failed_suspended,
+				READ_ONCE(hba->pm_op_in_progress),
+				READ_ONCE(hba->is_sys_suspended),
+				READ_ONCE(hba->outstanding_reqs),
+				work_busy(&hba->clk_gating.gate_work.work),
+				work_busy(&hba->clk_gating.ungate_work));
 			trace_ufshcd_clk_gating(hba,
 						hba->clk_gating.state);
+
+			/*
+			 * A non-MCQ relink cannot rely on this controller's threaded
+			 * IRQ making forward progress across PM.  Use the out-of-band
+			 * completion poller installed by the SM8550 relink patch.
+			 */
+			if (!hba->mcq_enabled) {
+				WRITE_ONCE(hba->relink_poll_active, true);
+				mod_timer(&hba->pm_poll_timer,
+					  jiffies + msecs_to_jiffies(2));
+			}
+			ret = ufshcd_link_recovery(hba);
+			if (!hba->mcq_enabled) {
+				WRITE_ONCE(hba->relink_poll_active, false);
+				timer_delete_sync(&hba->pm_poll_timer);
+			}
+
+			/*
+			 * Do not retry a destructive idle-Hibern8 transition this boot.
+			 * Pinning active_reqs is how clkgate_enable=0 keeps normal
+			 * hold/release pairs balanced while clock gating is disabled.
+			 */
+			scoped_guard(spinlock_irqsave, &hba->clk_gating.lock) {
+				if (hba->clk_gating.is_enabled) {
+					hba->clk_gating.active_reqs++;
+					hba->clk_gating.is_enabled = false;
+				}
+			}
+			WRITE_ONCE(hba->sm8550_gate_recovery_active, false);
+
+			if (ret)
+				dev_err(hba->dev,
+					"%s: link recovery after hibern8 enter failed %d\n",
+					__func__, ret);
+			else
+				dev_warn(hba->dev,
+					 "%s: link recovered; runtime clock gating disabled\n",
+					 __func__);
 			return;
 		}
 		ufshcd_set_link_hibern8(hba);
+		if (recover_inline)
+			WRITE_ONCE(hba->sm8550_gate_recovery_active, false);
 	}
 
 	ufshcd_disable_irq(hba);
@@ -4488,10 +4597,12 @@ static int ufshcd_uic_pwr_ctrl(struct ufs_hba *hba, struct uic_command *cmd)
 	 * Suppress fatal link-broken+EH for the SW clk-gating ungate hibern8
 	 * exit. That path runs outside pm_op_in_progress during the freezer
 	 * phase; ufshcd_ungate_work handles recovery inline instead.
+	 * The gate worker sets a dedicated flag while its recovery is active.
 	 */
 	if (ret && !hba->pm_op_in_progress &&
 	    (!ufshcd_sm8550_relink_workaround(hba) ||
-	     !hba->clk_gating.is_suspended)) {
+	     (!hba->clk_gating.is_suspended &&
+	      !READ_ONCE(hba->sm8550_gate_recovery_active)))) {
 		ufshcd_set_link_broken(hba);
 		ufshcd_schedule_eh_work(hba);
 	}
--- a/include/ufs/ufshcd.h
+++ b/include/ufs/ufshcd.h
@@ -1079,6 +1079,8 @@ enum ufshcd_mcq_opr {
  *	cache of device M-PHY TX_HS_DeEmphasis_Setting_Capability Attribute (ID 0x12)
  * @tx_eq_params: TX Equalization settings
  * @sm8550_native_sleep_workarounds: whether the opt-in SM8550 UFS path is active
+ * @sm8550_gate_recovery_active: whether clock-gate Hibern8 recovery owns
+ *	UIC errors
  */
 struct ufs_hba {
 	void __iomem *mmio_base;
@@ -1123,6 +1125,7 @@ struct ufs_hba {
 	unsigned long pm_drain_active;
 	bool relink_poll_active;
 	bool sm8550_native_sleep_workarounds;
+	bool sm8550_gate_recovery_active;
 
 	/* Auto-Hibernate Idle Timer register value */
 	u32 ahit;
