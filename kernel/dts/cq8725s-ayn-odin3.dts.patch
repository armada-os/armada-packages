From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: odin3: enable DPU dithering and DP alt audio

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
@@ -217,6 +217,9 @@
 &display_panel {
 	compatible = "chipone,icna3520";
 
+	/* 8bpc DSI link; dither the DPU 10-bit downconvert to hide banding */
+	armada,dpu-8bpc-dither;
+
 	reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
 
 	vddio-supply = <&vreg_l12b_1p8>;
@@ -349,4 +349,29 @@
			debounce-interval = <15>;
		};
	};
+
+	sound {
+		/* HDMI audio out over USB-C DP alt mode.
+		 * The codec side is the hdmi-codec the DP bridge registers as a
+		 * child of &mdss_dp0, and this link is also what makes the
+		 * machine driver create the "DP0 Jack" control that UCM keys the
+		 * HDMI device off.
+		 * Needs the DISPLAY_PORT_RX_0 graph in the topology blob.
+		 */
+		dp-dai-link {
+			link-name = "DisplayPort Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
 };
