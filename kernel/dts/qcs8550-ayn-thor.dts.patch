From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: thor: fix hall, touch orientation, and suspend power

diff --git a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
index f89acee..ec8474a 100644
--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
@@ -30,6 +30,8 @@
 
 	gpio-keys-lid {
 		compatible = "gpio-keys";
+		pinctrl-0 = <&hall_lid_n>;
+		pinctrl-names = "default";
 
 		hall-lid-sensor {
 			label = "Hall Lid Sensor";
@@ -275,8 +277,6 @@
 
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <1920>;
-		touchscreen-swapped-x-y;
-		touchscreen-inverted-x;
 
 		label = "top_touchscreen";
 	};
@@ -393,11 +393,11 @@
 
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <1240>;
-		touchscreen-swapped-x-y;
-		touchscreen-inverted-x;
 
 		label = "bottom_touchscreen";
 
+		edt,retain-power-in-suspend;
+
 		no-regmap-bulk-read;
 	};
 };
@@ -452,6 +452,15 @@
 		bias-pull-up;
 		output-disable;
 	};
+
+	/* Open-drain hall output: with no pull-up the released (lid open)
+	   level is undefined. */
+	hall_lid_n: hall-lid-n-state {
+		pins = "gpio17";
+		function = "gpio";
+		bias-pull-up;
+		output-disable;
+	};
 };
 
 &remoteproc_adsp {
